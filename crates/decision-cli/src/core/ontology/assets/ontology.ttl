# Base ontology for decision-cli's orchestration graph.
#
# FT-006 / ADR-007 — this file is embedded into the `dec` binary via
# `include_str!`. Bumping the ontology version is intentionally tied
# to a binary release: the bootstrap session records the version that
# was in effect at `dec init` time so the inputs to validation are
# reproducible.
#
# This declaration is intentionally minimal; the SHACL constraints
# that gate `dec init` live in the sibling `shapes.ttl`.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- Ontology header ---------------------------------------------------------

<https://decision-cli.dev/ns> a owl:Ontology ;
    rdfs:label       "decision-cli base ontology" ;
    owl:versionInfo  "0.5.0" .

# --- Classes (decision-cli-slice-1-bounds.md §5.3) ---------------------------

dec:ValueStream a rdfs:Class ;
    rdfs:label "ValueStream" ;
    rdfs:comment "A value stream — the full chain of processes terminating in a specific value action." .

dec:ValueAction a rdfs:Class ;
    rdfs:label "ValueAction" ;
    rdfs:comment "A canonical, schema-validated value action with stable URI, exit criteria, expected outputs, and compatible goals." .

dec:Goal a rdfs:Class ;
    rdfs:label "Goal" ;
    rdfs:comment "A goal verb (e.g. ship, land) that a stream authorises a session to pursue." .

dec:Session a rdfs:Class ;
    rdfs:label "Session" ;
    rdfs:comment "An orchestrator-managed role execution; emits a typed artifact." .

dec:Dispatch a rdfs:Class ;
    rdfs:label "Dispatch" ;
    rdfs:comment "A role-dispatch event placing work on a worker." .

dec:Event a rdfs:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A graph-native event derived from a mutation (ADR-002)." .

# --- Slice-2 classes: roles, authority, dispatch pairing (FT-019, ADR-017) ---

dec:Role a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A catalog entry naming an LLM-backed role, its input and output artifact types, and (per ADR-027) its authority declaration." .

dec:Authority a rdfs:Class ;
    rdfs:label "Authority" ;
    rdfs:comment "A role's bounded authority declaration (ADR-027)." .

dec:ActionSession a rdfs:Class ;
    rdfs:subClassOf dec:Session ;
    rdfs:label "ActionSession" ;
    rdfs:comment "A session that produces an action artifact (e.g. the implementer's CodeChange) — ADR-017." .

dec:InterpretationSession a rdfs:Class ;
    rdfs:subClassOf dec:Session ;
    rdfs:label "InterpretationSession" ;
    rdfs:comment "A session that produces a verdict on an action artifact (the verifier's VerificationVerdict) — ADR-017." .

dec:DispatchGroup a rdfs:Class ;
    rdfs:label "DispatchGroup" ;
    rdfs:comment "Pairs an ActionSession with its InterpretationSession (ADR-017)." .

# --- FT-020 / ADR-018: VerificationVerdict ------------------------------------

dec:VerificationVerdict a rdfs:Class ;
    rdfs:label "VerificationVerdict" ;
    rdfs:comment "The verdict the verifier role produces on an action artifact (ADR-018). Gates dispatch completion per ADR-017." .

# --- Properties --------------------------------------------------------------

dec:name a rdf:Property ;
    rdfs:domain dec:ValueStream , dec:ValueAction ;
    rdfs:range  xsd:string .

dec:title a rdf:Property ;
    rdfs:domain dec:ValueStream ;
    rdfs:range  xsd:string .

dec:description a rdf:Property ;
    rdfs:range xsd:string .

dec:terminalValueAction a rdf:Property ;
    rdfs:domain dec:ValueStream ;
    rdfs:range  dec:ValueAction .

dec:authorizedGoals a rdf:Property ;
    rdfs:domain dec:ValueStream .

dec:compatibleGoals a rdf:Property ;
    rdfs:domain dec:ValueAction .

dec:expectedOutputType a rdf:Property ;
    rdfs:domain dec:ValueAction ;
    rdfs:range  xsd:string .

dec:exitCriterion a rdf:Property ;
    rdfs:domain dec:ValueAction ;
    rdfs:range  xsd:string .

dec:basePolicy a rdf:Property ;
    rdfs:domain dec:ValueStream .

dec:inStream a rdf:Property ;
    rdfs:range dec:ValueStream ;
    rdfs:comment "Every scoped artifact (Session, Goal, Dispatch, Event) carries dec:inStream → dec:ValueStream (ADR-005)." .

# --- Slice-2 properties: Role + DispatchGroup (FT-019, ADR-017) --------------

dec:roleId a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  xsd:string ;
    rdfs:comment "Stable identifier the orchestrator dispatches against (e.g. \"verifier\")." .

dec:roleInputType a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:comment "An artifact type the role consumes (multi-valued)." .

dec:roleOutputType a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:comment "The artifact type the role produces (typically single-valued)." .

dec:roleModelBinding a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  xsd:string ;
    rdfs:comment "Slice-2 hardcoded model id used to dispatch this role (ADR-020 keeps Phase A bindings inline)." .

dec:roleAuthority a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  dec:Authority ;
    rdfs:comment "Optional authority declaration carried by the role (ADR-027 — landed by FT-030)." .

dec:authority a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  dec:Authority ;
    rdfs:comment "Authority declaration for a role (ADR-027 / FT-030). Each dec:Role MUST carry exactly one dec:authority link to a dec:Authority node." .

# --- FT-030 / ADR-027: Authority properties ----------------------------------

dec:mayDecide a rdf:Property ;
    rdfs:domain dec:Authority ;
    rdfs:range  xsd:string ;
    rdfs:comment "Category names the role's worker MAY decide unilaterally (ADR-027). Multi-valued." .

dec:mustEscalate a rdf:Property ;
    rdfs:domain dec:Authority ;
    rdfs:range  xsd:string ;
    rdfs:comment "Category names the role's worker MUST escalate via feedback (ADR-027). Multi-valued, disjoint from dec:mayDecide." .

dec:escalateVia a rdf:Property ;
    rdfs:domain dec:Authority ;
    rdfs:comment "Routing hint per mustEscalate category — links to a blank-node descriptor carrying dec:escalateCategory, dec:escalateClass, dec:escalateTargetRole (ADR-027)." .

dec:escalateCategory a rdf:Property ;
    rdfs:range  xsd:string ;
    rdfs:comment "The mustEscalate category name this routing hint applies to." .

dec:escalateClass a rdf:Property ;
    rdfs:range  xsd:string ;
    rdfs:comment "Feedback class (ADR-023) the escalation should be emitted as." .

dec:escalateTargetRole a rdf:Property ;
    rdfs:range  xsd:string ;
    rdfs:comment "Default target role for the escalation (ADR-027)." .

dec:hasActionSession a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  dec:ActionSession ;
    rdfs:comment "Links a DispatchGroup to its paired ActionSession (ADR-017)." .

dec:hasInterpretationSession a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  dec:InterpretationSession ;
    rdfs:comment "Links a DispatchGroup to its paired InterpretationSession (ADR-017)." .

dec:dispatchedFor a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  xsd:string ;
    rdfs:comment "The feature_spec id (e.g. \"FT-021\") this DispatchGroup is acting on (ADR-017 / FT-021)." .

dec:dispatchStatus a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lifecycle state of the DispatchGroup: awaiting-action | awaiting-interpretation | interpretation-running | interpretation-rejected | awaiting-amendment | action-failed | interpretation-failed | complete | paused-for-feedback | feedback-rejected-action-blocked (FT-021 / FT-032 / ADR-025)." .

dec:blockedBy a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  dec:Feedback ;
    rdfs:comment "Each blocking dec:Feedback that gates resumption of a paused DispatchGroup (FT-032 / ADR-025). The dispatch refuses to advance to awaiting-interpretation while any linked feedback is non-terminal." .

# --- FT-020 / ADR-018: VerificationVerdict properties -----------------------

dec:verdict a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "One of \"approved\", \"rejected\", \"amendment-required\" (ADR-018)." .

dec:rationale a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form prose, sh:minLength 20 (ADR-018)." .

dec:violates a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:comment "References to TCs or ADRs that the action artifact violated (ADR-018). Required for rejected/amendment-required verdicts." .

dec:amendmentGuidance a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form text consumed by the next action when verdict = amendment-required (ADR-018)." .

# --- FT-026 / ADR-022: Feedback artifact -------------------------------------

dec:Feedback a rdfs:Class ;
    rdfs:label "Feedback" ;
    rdfs:comment "A first-class feedback artifact emitted by a session about its bundle or its own output (ADR-022)." .

dec:feedbackClass a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Controlled-vocabulary class tag (ADR-023). Domain values land in FT-028; here we only mandate cardinality." .

dec:severity a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Severity hint (info | warning | error). Defaults to \"warning\"." .

dec:targetRole a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Role id the feedback is routed to (mirrors dec:roleId on Role catalog entries)." .

dec:evidence a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form citation back into the originating bundle or artifact." .

dec:recommendation a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional suggested fix the target role may consult." .

dec:lifecycleState a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lifecycle state per ADR-024 (FT-027 lands the state machine; FT-026 only enforces cardinality)." .

dec:sourceSession a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Session ;
    rdfs:comment "PROV-O-linked session that emitted the feedback." .

dec:sourceArtifact a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "Optional: the bundled artifact the feedback is about." .

dec:addressingArtifact a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "The artifact that resolves the feedback (set on lifecycle transition to addressed)." .

dec:closedBy a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "Actor (session or human) that closed the loop." .

dec:rejectionReason a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form rationale recorded when the target role rejected the feedback." .

dec:supersededBy a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Feedback ;
    rdfs:comment "Newer feedback artifact that subsumes this one (terminal supersession per ADR-024)." .

dec:routedAt a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Wall-clock timestamp the orchestrator transitioned this feedback to routed." .

dec:receivingSession a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Session ;
    rdfs:comment "Session that picked up the routed feedback (terminal step receive)." .

dec:dispositionOverride a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Per-emission blocking / non-blocking override (ADR-025). Either \"blocking\" or \"non-blocking\"." .

dec:dispositionRationale a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Operator-facing rationale for dec:dispositionOverride." .

# --- FT-035 / ADR-028: VerificationEnvironment ------------------------------

dec:VerificationEnvironment a rdfs:Class ;
    rdfs:label "VerificationEnvironment" ;
    rdfs:comment "A typed execution context for verification graphs (ADR-028 §VerificationEnvironment). Carries an envType, safetyClass, allowedOps list, optional setup/teardown, and (for remote types) an endpoint." .

dec:envType a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Environment type tag (e.g. \"ephemeral-tempdir\", \"remote-http\")." .

dec:safetyClass a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Safety classification — one of {isolated, shared-non-destructive, production-readonly}." .

dec:allowedOps a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:comment "Non-empty rdf:List of operation tokens permitted by this environment (ADR-028)." .

dec:setup a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional shell snippet executed before any step runs against the environment." .

dec:teardown a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional shell snippet executed after step execution." .

dec:endpoint a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Required for remote environment types (e.g. remote-http); URL of the target endpoint. Local environment types MUST NOT carry an endpoint (SHACL conditional)." .

dec:fixtureSource a rdf:Property ;
    rdfs:domain dec:VerificationEnvironment ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional repo-relative path to a fixture tree materialised before steps execute (FT-053 / ADR-032). Per ADR-032, by convention fixtures live under tests/fixtures/<name>/." .

# --- FT-036 / ADR-028: VerificationGraph + VerificationStep -----------------

dec:VerificationGraph a rdfs:Class ;
    rdfs:label "VerificationGraph" ;
    rdfs:comment "A graph of typed verification steps targeting a feature or TC inside a specific VerificationEnvironment (ADR-028)." .

dec:VerificationStep a rdfs:Class ;
    rdfs:label "VerificationStep" ;
    rdfs:comment "A typed step inside a VerificationGraph; kind-specific shape is selected by dec:stepType (ADR-028)." .

dec:verifies a rdf:Property ;
    rdfs:domain dec:VerificationGraph ;
    rdfs:comment "The artifact the graph proves about — a feature_spec (dec:Feature) or a test criterion (dec:TC). Polymorphic per ADR-028." .

dec:environment a rdf:Property ;
    rdfs:domain dec:VerificationGraph ;
    rdfs:range  dec:VerificationEnvironment ;
    rdfs:comment "The VerificationEnvironment this graph executes against (ADR-028)." .

dec:steps a rdf:Property ;
    rdfs:domain dec:VerificationGraph ;
    rdfs:comment "rdf:List of VerificationStep IRIs in execution order. May be empty during authoring; non-empty is a pre-dispatch invariant (ADR-028)." .

dec:stepType a rdf:Property ;
    rdfs:domain dec:VerificationStep ;
    rdfs:range  xsd:string ;
    rdfs:comment "Step kind tag — one of {shell-command, sparql-assertion, file-assertion, http-request, wait-for, capture} in slice 2.5 (ADR-028)." .

dec:requiredOps a rdf:Property ;
    rdfs:domain dec:VerificationStep ;
    rdfs:comment "rdf:List of operation tokens the step requires (consumed by FT-037 safety enforcement)." .

dec:providesEvidenceFor a rdf:Property ;
    rdfs:domain dec:VerificationStep ;
    rdfs:comment "Optional, multi-valued — TC IRIs this step provides evidence for (ADR-028 coverage predicate)." .

dec:command a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Shell-command step body (ADR-028)." .

dec:expectExitCode a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:comment "Shell-command exit-code expectation (ADR-028)." .

dec:captureOutput a rdf:Property ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Shell-command bind-stdout flag (ADR-028)." .

dec:target a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Sparql-assertion target store path or endpoint (ADR-028)." .

dec:query a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Sparql-assertion query text (ADR-028)." .

dec:expectRows a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:comment "Sparql-assertion row-count expectation (ADR-028)." .

dec:path a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "File-assertion target path (ADR-028)." .

dec:expectHash a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "File-assertion hash expectation (ADR-028)." .

dec:expectContent a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "File-assertion content expectation (ADR-028)." .

dec:method a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Http-request method (ADR-028)." .

dec:url a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Http-request target URL (ADR-028)." .

dec:expectStatus a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:comment "Http-request status-code expectation (ADR-028)." .

dec:condition a rdf:Property ;
    rdfs:comment "Wait-for sub-condition reference (ADR-028)." .

dec:timeout a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Wait-for timeout (ISO 8601 duration; ADR-028)." .

dec:fromStep a rdf:Property ;
    rdfs:comment "Capture step source step reference (ADR-028)." .

dec:bindAs a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Capture step binding name (ADR-028)." .

# --- FT-054 / ADR-033: Capability artifact -----------------------------------

dec:Capability a rdfs:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "A versioned binding from a stable capability tag to a concrete (endpoint, model_identifier, parameters) triple plus declared model properties (FT-054 / ADR-033)." .

dec:capability_id a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Stable tag used by roles to reference this capability (e.g. \"code-writer\", \"deep-reasoning\")." .

dec:model_identifier a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Exact API model string (e.g. \"qwen3-coder-30b-a3b-instruct\", \"claude-opus-4-7\")." .

dec:tier a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Optional escalation-ladder tier (0–3); omitted for specialty / candidate capabilities (FT-054 / ADR-034)." .

dec:context_window a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Context window size in tokens (non-negative)." .

dec:max_output a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Maximum output tokens the capability emits (non-negative)." .

dec:supports_vision a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True iff the capability accepts image inputs." .

dec:supports_tool_calling a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True iff the capability supports function/tool calling." .

dec:cost_input_per_m a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Cost per 1M input tokens in units of dec:cost_currency (non-negative)." .

dec:cost_output_per_m a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Cost per 1M output tokens in units of dec:cost_currency (non-negative)." .

dec:cost_cache_hit_per_m a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Optional cost per 1M cache-hit input tokens (non-negative). Set only on endpoints with prompt caching (currently Anthropic). Paired with dec:cost_cache_write_5m." .

dec:cost_cache_write_5m a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:decimal ;
    rdfs:comment "Optional cost per 1M tokens written to the 5-minute TTL cache (non-negative). Paired with dec:cost_cache_hit_per_m." .

dec:cost_currency a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Currency unit for the four cost fields (one of {EUR, USD})." .

dec:configurable_effort a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "Optional (default false). True iff the capability accepts a reasoning_effort parameter (FT-063)." .

dec:exposes_reasoning_trace a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "Optional (default false). True iff the capability emits a separate reasoning trace alongside content (FT-060 §10.6)." .

dec:status a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Capability lifecycle status (one of {active, preview, eol, candidate})." .

dec:version a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Monotonically increasing version (≥ 1). Combined with dec:capability_id forms unique key among active capabilities." .

dec:supersedes a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  dec:Capability ;
    rdfs:comment "Optional link from a newer Capability version to the prior version it supersedes." .

dec:bootstrap_source a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional content hash of the seed YAML the artifact was bootstrapped from (ADR-036 audit)." .

dec:notes a rdf:Property ;
    rdfs:domain dec:Capability ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional free-text catalog-maintainer notes." .

# --- FT-055 / ADR-033 / ADR-034: RoleBinding + escalation policy ------------

dec:RoleBinding a rdfs:Class ;
    rdfs:label "RoleBinding" ;
    rdfs:comment "A versioned binding from a role (FT-030 role catalog id) to its default capability plus an ordered list of escalation steps (FT-055 / ADR-033 / ADR-034)." .

dec:EscalationStep a rdfs:Class ;
    rdfs:label "EscalationStep" ;
    rdfs:comment "A candidate capability plus the set of triggers that selects it. Membership inside a RoleBinding is order-preserving via the parent's rdf:List of escalation_steps (ADR-034)." .

dec:EscalationTrigger a rdfs:Class ;
    rdfs:label "EscalationTrigger" ;
    rdfs:comment "A single trigger drawn from the closed ADR-034 vocabulary. OR-evaluated by the dispatcher per ADR-034 §dispatcher loop." .

dec:role_id a rdf:Property ;
    rdfs:domain dec:RoleBinding ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lookup key into the FT-030 role catalog (a plain string, NOT a class IRI — keeps RoleBinding independent of Role IRI minting)." .

dec:default_capability a rdf:Property ;
    rdfs:domain dec:RoleBinding ;
    rdfs:range  dec:Capability ;
    rdfs:comment "The capability dispatched when no escalation step's triggers fire." .

dec:escalation_steps a rdf:Property ;
    rdfs:domain dec:RoleBinding ;
    rdfs:comment "rdf:List of EscalationStep IRIs in order of escalation. Empty list (rdf:nil) is permitted for bounded-classification roles per ADR-037." .

dec:active a rdf:Property ;
    rdfs:domain dec:RoleBinding ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True iff this binding is the dispatcher's authoritative choice for its role_id. SHACL invariant: at most one active binding per role_id (FT-055)." .

dec:step_capability a rdf:Property ;
    rdfs:domain dec:EscalationStep ;
    rdfs:range  dec:Capability ;
    rdfs:comment "The capability promoted to when this step's triggers fire." .

dec:triggers a rdf:Property ;
    rdfs:domain dec:EscalationStep ;
    rdfs:range  dec:EscalationTrigger ;
    rdfs:comment "Set of EscalationTrigger IRIs whose OR selects this step. Multi-valued; sh:minCount 1." .

dec:trigger_signal a rdf:Property ;
    rdfs:domain dec:EscalationTrigger ;
    rdfs:range  xsd:string ;
    rdfs:comment "Trigger signal literal drawn from the ADR-034 closed vocabulary." .
