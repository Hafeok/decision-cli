# Base ontology for decision-cli's orchestration graph.
#
# FT-006 / ADR-007 — this file is embedded into the `dec` binary via
# `include_str!`. Bumping the ontology version is intentionally tied
# to a binary release: the bootstrap session records the version that
# was in effect at `dec init` time so the inputs to validation are
# reproducible.
#
# This declaration is intentionally minimal; the SHACL constraints
# that gate `dec init` live in the sibling `shapes.ttl`.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- Ontology header ---------------------------------------------------------

<https://decision-cli.dev/ns> a owl:Ontology ;
    rdfs:label       "decision-cli base ontology" ;
    owl:versionInfo  "0.2.0" .

# --- Classes (decision-cli-slice-1-bounds.md §5.3) ---------------------------

dec:ValueStream a rdfs:Class ;
    rdfs:label "ValueStream" ;
    rdfs:comment "A value stream — the full chain of processes terminating in a specific value action." .

dec:ValueAction a rdfs:Class ;
    rdfs:label "ValueAction" ;
    rdfs:comment "A canonical, schema-validated value action with stable URI, exit criteria, expected outputs, and compatible goals." .

dec:Goal a rdfs:Class ;
    rdfs:label "Goal" ;
    rdfs:comment "A goal verb (e.g. ship, land) that a stream authorises a session to pursue." .

dec:Session a rdfs:Class ;
    rdfs:label "Session" ;
    rdfs:comment "An orchestrator-managed role execution; emits a typed artifact." .

dec:Dispatch a rdfs:Class ;
    rdfs:label "Dispatch" ;
    rdfs:comment "A role-dispatch event placing work on a worker." .

dec:Event a rdfs:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A graph-native event derived from a mutation (ADR-002)." .

# --- Slice-2 classes: roles, authority, dispatch pairing (FT-019, ADR-017) ---

dec:Role a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A catalog entry naming an LLM-backed role, its input and output artifact types, and (per ADR-027) its authority declaration." .

dec:Authority a rdfs:Class ;
    rdfs:label "Authority" ;
    rdfs:comment "A role's bounded authority declaration (ADR-027)." .

dec:ActionSession a rdfs:Class ;
    rdfs:subClassOf dec:Session ;
    rdfs:label "ActionSession" ;
    rdfs:comment "A session that produces an action artifact (e.g. the implementer's CodeChange) — ADR-017." .

dec:InterpretationSession a rdfs:Class ;
    rdfs:subClassOf dec:Session ;
    rdfs:label "InterpretationSession" ;
    rdfs:comment "A session that produces a verdict on an action artifact (the verifier's VerificationVerdict) — ADR-017." .

dec:DispatchGroup a rdfs:Class ;
    rdfs:label "DispatchGroup" ;
    rdfs:comment "Pairs an ActionSession with its InterpretationSession (ADR-017)." .

# --- FT-020 / ADR-018: VerificationVerdict ------------------------------------

dec:VerificationVerdict a rdfs:Class ;
    rdfs:label "VerificationVerdict" ;
    rdfs:comment "The verdict the verifier role produces on an action artifact (ADR-018). Gates dispatch completion per ADR-017." .

# --- Properties --------------------------------------------------------------

dec:name a rdf:Property ;
    rdfs:domain dec:ValueStream , dec:ValueAction ;
    rdfs:range  xsd:string .

dec:title a rdf:Property ;
    rdfs:domain dec:ValueStream ;
    rdfs:range  xsd:string .

dec:description a rdf:Property ;
    rdfs:range xsd:string .

dec:terminalValueAction a rdf:Property ;
    rdfs:domain dec:ValueStream ;
    rdfs:range  dec:ValueAction .

dec:authorizedGoals a rdf:Property ;
    rdfs:domain dec:ValueStream .

dec:compatibleGoals a rdf:Property ;
    rdfs:domain dec:ValueAction .

dec:expectedOutputType a rdf:Property ;
    rdfs:domain dec:ValueAction ;
    rdfs:range  xsd:string .

dec:exitCriterion a rdf:Property ;
    rdfs:domain dec:ValueAction ;
    rdfs:range  xsd:string .

dec:basePolicy a rdf:Property ;
    rdfs:domain dec:ValueStream .

dec:inStream a rdf:Property ;
    rdfs:range dec:ValueStream ;
    rdfs:comment "Every scoped artifact (Session, Goal, Dispatch, Event) carries dec:inStream → dec:ValueStream (ADR-005)." .

# --- Slice-2 properties: Role + DispatchGroup (FT-019, ADR-017) --------------

dec:roleId a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  xsd:string ;
    rdfs:comment "Stable identifier the orchestrator dispatches against (e.g. \"verifier\")." .

dec:roleInputType a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:comment "An artifact type the role consumes (multi-valued)." .

dec:roleOutputType a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:comment "The artifact type the role produces (typically single-valued)." .

dec:roleModelBinding a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  xsd:string ;
    rdfs:comment "Slice-2 hardcoded model id used to dispatch this role (ADR-020 keeps Phase A bindings inline)." .

dec:roleAuthority a rdf:Property ;
    rdfs:domain dec:Role ;
    rdfs:range  dec:Authority ;
    rdfs:comment "Optional authority declaration carried by the role (ADR-027 — landed by FT-030)." .

dec:hasActionSession a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  dec:ActionSession ;
    rdfs:comment "Links a DispatchGroup to its paired ActionSession (ADR-017)." .

dec:hasInterpretationSession a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  dec:InterpretationSession ;
    rdfs:comment "Links a DispatchGroup to its paired InterpretationSession (ADR-017)." .

dec:dispatchedFor a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  xsd:string ;
    rdfs:comment "The feature_spec id (e.g. \"FT-021\") this DispatchGroup is acting on (ADR-017 / FT-021)." .

dec:dispatchStatus a rdf:Property ;
    rdfs:domain dec:DispatchGroup ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lifecycle state of the DispatchGroup: awaiting-action | awaiting-interpretation | interpretation-running | interpretation-rejected | awaiting-amendment | action-failed | interpretation-failed | complete (FT-021)." .

# --- FT-020 / ADR-018: VerificationVerdict properties -----------------------

dec:verdict a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "One of \"approved\", \"rejected\", \"amendment-required\" (ADR-018)." .

dec:rationale a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form prose, sh:minLength 20 (ADR-018)." .

dec:violates a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:comment "References to TCs or ADRs that the action artifact violated (ADR-018). Required for rejected/amendment-required verdicts." .

dec:amendmentGuidance a rdf:Property ;
    rdfs:domain dec:VerificationVerdict ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form text consumed by the next action when verdict = amendment-required (ADR-018)." .

# --- FT-026 / ADR-022: Feedback artifact -------------------------------------

dec:Feedback a rdfs:Class ;
    rdfs:label "Feedback" ;
    rdfs:comment "A first-class feedback artifact emitted by a session about its bundle or its own output (ADR-022)." .

dec:feedbackClass a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Controlled-vocabulary class tag (ADR-023). Domain values land in FT-028; here we only mandate cardinality." .

dec:severity a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Severity hint (info | warning | error). Defaults to \"warning\"." .

dec:targetRole a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Role id the feedback is routed to (mirrors dec:roleId on Role catalog entries)." .

dec:evidence a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form citation back into the originating bundle or artifact." .

dec:recommendation a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional suggested fix the target role may consult." .

dec:lifecycleState a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lifecycle state per ADR-024 (FT-027 lands the state machine; FT-026 only enforces cardinality)." .

dec:sourceSession a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Session ;
    rdfs:comment "PROV-O-linked session that emitted the feedback." .

dec:sourceArtifact a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "Optional: the bundled artifact the feedback is about." .

dec:addressingArtifact a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "The artifact that resolves the feedback (set on lifecycle transition to addressed)." .

dec:closedBy a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:comment "Actor (session or human) that closed the loop." .

dec:rejectionReason a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Free-form rationale recorded when the target role rejected the feedback." .

dec:supersededBy a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Feedback ;
    rdfs:comment "Newer feedback artifact that subsumes this one (terminal supersession per ADR-024)." .

dec:routedAt a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Wall-clock timestamp the orchestrator transitioned this feedback to routed." .

dec:receivingSession a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  dec:Session ;
    rdfs:comment "Session that picked up the routed feedback (terminal step receive)." .

dec:dispositionOverride a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Per-emission blocking / non-blocking override (ADR-025). Either \"blocking\" or \"non-blocking\"." .

dec:dispositionRationale a rdf:Property ;
    rdfs:domain dec:Feedback ;
    rdfs:range  xsd:string ;
    rdfs:comment "Operator-facing rationale for dec:dispositionOverride." .
