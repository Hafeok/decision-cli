# Per-type provenance composition shape for dec:Policy (FT-072 / ADR-038).
#
# A Policy artifact is authored either at the boundary (initial policies
# seeded at bootstrap), addressing a Feedback (a gap that motivated the
# policy change), or decomposing from a Brief that authorised the
# policy work.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:PolicyShape a sh:NodeShape ;
    sh:targetClass dec:Policy ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:addresses      ; sh:minCount 1 ; sh:class dec:Feedback ] ]
        [ sh:property [ sh:path dec:decomposesFrom ; sh:minCount 1 ; sh:class dec:Brief    ] ]
    ) .
