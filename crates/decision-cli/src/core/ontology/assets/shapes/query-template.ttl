# Per-type provenance composition shape for dec:QueryTemplate (FT-072 / ADR-038 / ADR-043).
#
# A QueryTemplate is itself a first-class artifact (the full-chain
# traversal query of ADR-043 ships as the canonical instance). Its
# motivational origin is either a Brief that authorised its addition, or
# a Feedback that revealed a query gap the template addresses. Bootstrap
# templates satisfy the sh:or via the BoundaryArtifact branch.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:QueryTemplateShape a sh:NodeShape ;
    sh:targetClass dec:QueryTemplate ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:decomposesFrom ; sh:minCount 1 ; sh:class dec:Brief    ] ]
        [ sh:property [ sh:path dec:addresses      ; sh:minCount 1 ; sh:class dec:Feedback ] ]
    ) .
