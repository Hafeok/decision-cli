# Per-type provenance composition shape for dec:Dependency (FT-072 / ADR-038).
#
# A Dependency's motivational origin is the Feature or ADR that requires
# it. The :requiredBy predicate's range is left to the per-type shape per
# FT-070; both Feature and ADR are valid targets in slice 1.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:DependencyShape a sh:NodeShape ;
    sh:targetClass dec:Dependency ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:requiredBy ; sh:minCount 1 ; sh:class dec:Feature ] ]
        [ sh:property [ sh:path dec:requiredBy ; sh:minCount 1 ; sh:class dec:ADR     ] ]
    ) .
