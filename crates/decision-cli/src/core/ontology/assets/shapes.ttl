# SHACL shapes for the decision-cli base ontology.
#
# FT-006 / ADR-007: shipped embedded in the binary and exposed via
# `OntologyHandle::shapes_graph()` for the FT-008 init validation
# pipeline. The shapes encode the §5.3 invariants:
#
#   dec:ValueStream  → dec:name, dec:title, dec:terminalValueAction,
#                      dec:authorizedGoals (≥1)
#   dec:ValueAction  → dec:name, dec:description, dec:exitCriterion,
#                      dec:expectedOutputType, dec:compatibleGoals (≥1)

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# --- ValueStream shape -------------------------------------------------------

dec:ValueStreamShape a sh:NodeShape ;
    sh:targetClass dec:ValueStream ;

    sh:property [
        sh:path     dec:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueStream requires exactly one dec:name (string)."
    ] ;

    sh:property [
        sh:path     dec:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueStream requires exactly one dec:title (string)."
    ] ;

    sh:property [
        sh:path     dec:terminalValueAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:ValueStream requires exactly one dec:terminalValueAction (IRI)."
    ] ;

    sh:property [
        sh:path     dec:authorizedGoals ;
        sh:minCount 1 ;
        sh:message  "dec:ValueStream requires at least one dec:authorizedGoals entry."
    ] .

# --- ValueAction shape -------------------------------------------------------

dec:ValueActionShape a sh:NodeShape ;
    sh:targetClass dec:ValueAction ;

    sh:property [
        sh:path     dec:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueAction requires exactly one dec:name (string)."
    ] ;

    sh:property [
        sh:path     dec:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueAction requires at least one dec:description."
    ] ;

    sh:property [
        sh:path     dec:exitCriterion ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:exitCriterion."
    ] ;

    sh:property [
        sh:path     dec:expectedOutputType ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:expectedOutputType."
    ] ;

    sh:property [
        sh:path     dec:compatibleGoals ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:compatibleGoals entry."
    ] .

# --- Role shape (FT-019) -----------------------------------------------------

dec:RoleShape a sh:NodeShape ;
    sh:targetClass dec:Role ;

    sh:property [
        sh:path     dec:roleId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Role requires exactly one dec:roleId (string)."
    ] ;

    sh:property [
        sh:path     dec:roleInputType ;
        sh:minCount 1 ;
        sh:message  "dec:Role requires at least one dec:roleInputType."
    ] ;

    sh:property [
        sh:path     dec:roleOutputType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Role requires exactly one dec:roleOutputType (IRI)."
    ] ;

    sh:property [
        sh:path     dec:roleModelBinding ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Role requires exactly one dec:roleModelBinding (string)."
    ] ;

    sh:property [
        sh:path     dec:authority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Role requires exactly one dec:authority link to a dec:Authority (ADR-027 / FT-030)."
    ] .

# --- Authority shape (FT-030 / ADR-027) --------------------------------------

dec:AuthorityShape a sh:NodeShape ;
    sh:targetClass dec:Authority ;

    sh:property [
        sh:path     dec:mayDecide ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Authority requires at least one dec:mayDecide category (ADR-027)."
    ] ;

    sh:property [
        sh:path     dec:mustEscalate ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Authority requires at least one dec:mustEscalate category (ADR-027)."
    ] ;

    sh:property [
        sh:path     dec:rationale ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Authority requires exactly one dec:rationale (string, ADR-027)."
    ] ;

    # mayDecide and mustEscalate must be disjoint (ADR-027 invariant).
    sh:sparql [
        sh:message "dec:mayDecide and dec:mustEscalate categories must be disjoint (ADR-027)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:mayDecide ?cat .
              $this dec:mustEscalate ?cat .
            }
        """
    ] ;

    # Every mustEscalate category must have at least one dec:escalateVia
    # entry naming it (ADR-027 invariant).
    sh:sparql [
        sh:message "every dec:mustEscalate category must have at least one dec:escalateVia entry (ADR-027)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:mustEscalate ?cat .
              FILTER NOT EXISTS {
                $this dec:escalateVia ?hint .
                ?hint dec:escalateCategory ?cat .
              }
            }
        """
    ] .

# --- DispatchGroup shape (FT-021 / ADR-017) ----------------------------------

dec:DispatchGroupShape a sh:NodeShape ;
    sh:targetClass dec:DispatchGroup ;

    sh:property [
        sh:path     dec:dispatchStatus ;
        sh:in       ( "awaiting-action"
                      "awaiting-interpretation"
                      "interpretation-running"
                      "interpretation-rejected"
                      "awaiting-amendment"
                      "action-failed"
                      "interpretation-failed"
                      "complete"
                      "paused-for-feedback"
                      "feedback-rejected-action-blocked" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:DispatchGroup requires exactly one dec:dispatchStatus from the enumerated lifecycle set (FT-021 / ADR-017 / FT-032 / ADR-025)."
    ] ;

    sh:property [
        sh:path     dec:dispatchedFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:DispatchGroup requires exactly one dec:dispatchedFor (the feature_spec id)."
    ] ;

    sh:property [
        sh:path     dec:hasActionSession ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:DispatchGroup requires exactly one dec:hasActionSession link (ADR-017)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:DispatchGroup requires exactly one dec:inStream link (ADR-005)."
    ] ;

    # FT-032 / ADR-025 — paused-for-feedback groups MUST carry at least
    # one dec:blockedBy link to the gating dec:Feedback. The constraint
    # only fires when dispatchStatus = "paused-for-feedback"; other
    # states are unaffected.
    sh:sparql [
        sh:message  "paused-for-feedback DispatchGroup requires at least one dec:blockedBy (FT-032 / ADR-025)" ;
        sh:select   """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:dispatchStatus "paused-for-feedback" .
              FILTER NOT EXISTS { $this dec:blockedBy ?fb }
            }
        """
    ] .

# --- VerificationVerdict shape (FT-020 / ADR-018) ---------------------------

dec:VerificationVerdictShape a sh:NodeShape ;
    sh:targetClass dec:VerificationVerdict ;

    sh:property [
        sh:path     dec:verdict ;
        sh:in       ( "approved" "rejected" "amendment-required" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one dec:verdict in {approved, rejected, amendment-required}."
    ] ;

    sh:property [
        sh:path      dec:rationale ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 20 ;
        sh:message   "dec:VerificationVerdict requires exactly one dec:rationale (string, ≥ 20 chars)."
    ] ;

    sh:property [
        sh:path     prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one prov:wasGeneratedBy (the InterpretationSession)."
    ] ;

    sh:property [
        sh:path     prov:used ;
        sh:minCount 1 ;
        sh:message  "dec:VerificationVerdict requires at least one prov:used (the action artifacts consumed)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one dec:inStream link (ADR-005)."
    ] ;

    sh:property [
        sh:path     dec:amendmentGuidance ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict carries at most one dec:amendmentGuidance (required iff verdict = amendment-required, enforced separately)."
    ] .

# --- Feedback shape (FT-026 / ADR-022) ---------------------------------------
# Enforces required-field cardinality per ADR-022. Class-specific vocabulary
# (sh:in for dec:feedbackClass) lands in FT-028; state-machine transitions
# land in FT-027.

dec:FeedbackShape a sh:NodeShape ;
    sh:targetClass dec:Feedback ;

    sh:property [
        sh:path     dec:feedbackClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "gap" "contradiction" "unimplementable"
                      "scope-issue" "defect" "capability-request" ) ;
        sh:message  "dec:Feedback requires exactly one dec:feedbackClass from the ADR-023 enumeration."
    ] ;

    sh:property [
        sh:path     dec:lifecycleState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "produced" "routed" "received"
                      "addressed" "closed" "rejected" "superseded" ) ;
        sh:message  "dec:Feedback requires exactly one dec:lifecycleState from the ADR-024 enumeration."
    ] ;

    sh:property [
        sh:path     dec:targetRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Feedback requires exactly one dec:targetRole (string, mirrors dec:roleId)."
    ] ;

    sh:property [
        sh:path      dec:evidence ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:Feedback requires exactly one non-empty dec:evidence (string)."
    ] ;

    sh:property [
        sh:path     dec:sourceSession ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Feedback requires exactly one dec:sourceSession (IRI)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Feedback requires exactly one dec:inStream link (ADR-005)."
    ] ;

    sh:property [
        sh:path     dec:severity ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:severity (string)."
    ] ;

    sh:property [
        sh:path     dec:recommendation ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:recommendation (string)."
    ] ;

    sh:property [
        sh:path     dec:sourceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:sourceArtifact (IRI)."
    ] ;

    sh:property [
        sh:path     dec:addressingArtifact ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:addressingArtifact (IRI)."
    ] ;

    sh:property [
        sh:path     dec:rejectionReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:rejectionReason (string)."
    ] ;

    sh:property [
        sh:path     dec:supersededBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:supersededBy (IRI)."
    ] ;

    sh:property [
        sh:path     dec:dispositionOverride ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:dispositionOverride (string)."
    ] ;

    # --- Lifecycle companion-field constraints (ADR-024) ---------------
    # Each state requires its companion fields per ADR-024 §SHACL fragment.

    sh:sparql [
        sh:message "routed state requires dec:routedAt and dec:targetRole" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "routed" .
              FILTER NOT EXISTS { $this dec:routedAt ?t . $this dec:targetRole ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "received state requires dec:receivingSession" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "received" .
              FILTER NOT EXISTS { $this dec:receivingSession ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "addressed state requires dec:addressingArtifact" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "addressed" .
              FILTER NOT EXISTS { $this dec:addressingArtifact ?a }
            }
        """
    ] ;

    sh:sparql [
        sh:message "closed state requires dec:closedBy AND dec:addressingArtifact (PROV-O)" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "closed" .
              FILTER NOT EXISTS { $this dec:closedBy ?c . $this dec:addressingArtifact ?a }
            }
        """
    ] ;

    sh:sparql [
        sh:message "rejected state requires dec:rejectionReason" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "rejected" .
              FILTER NOT EXISTS { $this dec:rejectionReason ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "superseded state requires dec:supersededBy" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "superseded" .
              FILTER NOT EXISTS { $this dec:supersededBy ?s }
            }
        """
    ] .

# --- VerificationEnvironment shape (FT-035 / ADR-028) -----------------------
# Enforces ADR-028 §VerificationEnvironment invariants:
#   - dec:envType is a non-empty string,
#   - dec:safetyClass ∈ {isolated, shared-non-destructive, production-readonly},
#   - dec:allowedOps is a non-empty rdf:List of operation tokens,
#   - dec:endpoint required iff dec:envType matches the remote-type pattern.

dec:VerificationEnvironmentShape a sh:NodeShape ;
    sh:targetClass dec:VerificationEnvironment ;

    sh:property [
        sh:path      dec:envType ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:VerificationEnvironment requires exactly one non-empty dec:envType (string)."
    ] ;

    sh:property [
        sh:path     dec:safetyClass ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "isolated" "shared-non-destructive" "production-readonly" ) ;
        sh:message  "dec:VerificationEnvironment requires exactly one dec:safetyClass from {isolated, shared-non-destructive, production-readonly}."
    ] ;

    sh:property [
        sh:path     dec:allowedOps ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationEnvironment requires exactly one dec:allowedOps rdf:List."
    ] ;

    sh:property [
        sh:path     dec:setup ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationEnvironment carries at most one dec:setup (string)."
    ] ;

    sh:property [
        sh:path     dec:teardown ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationEnvironment carries at most one dec:teardown (string)."
    ] ;

    sh:property [
        sh:path     dec:endpoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationEnvironment carries at most one dec:endpoint (string)."
    ] ;

    # Remote env types (matching the remote-* prefix) must carry dec:endpoint.
    sh:sparql [
        sh:message "remote env types (envType starts with \"remote-\") require dec:endpoint" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:envType ?t .
              FILTER(STRSTARTS(STR(?t), "remote-"))
              FILTER NOT EXISTS { $this dec:endpoint ?e }
            }
        """
    ] ;

    # Local env types (envType does NOT start with "remote-") must NOT carry dec:endpoint.
    sh:sparql [
        sh:message "local env types (envType does not start with \"remote-\") must NOT carry dec:endpoint" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:envType ?t .
              FILTER(!STRSTARTS(STR(?t), "remote-"))
              $this dec:endpoint ?e .
            }
        """
    ] ;

    # allowedOps list must be non-empty (head is not rdf:nil).
    sh:sparql [
        sh:message "dec:allowedOps must be a non-empty rdf:List (head must not be rdf:nil)" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
              $this dec:allowedOps rdf:nil .
            }
        """
    ] .
