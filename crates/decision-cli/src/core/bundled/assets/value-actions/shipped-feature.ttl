# Canonical bundled ValueAction `va:shipped-feature` — referenced by
# the slice-1 `engineering-development` stream template.
#
# FT-007 (bundled library) owns this asset; FT-006 references it from
# the resolver because TC-001 needs a happy-path template wired
# end-to-end. Per ADR-007 the file is embedded in the binary and
# carries a stable URI so two streams pointing at the same URI are
# provably aimed at the same thing.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix va:  <https://decision-cli.dev/ns/value-actions/> .

va:shipped-feature a dec:ValueAction ;
    dec:name              "shipped-feature" ;
    dec:description       "A feature is shipped when its code is on the trunk branch, all tests pass, and consumers can use it." ;
    dec:exitCriterion     "tests-pass" , "merged-to-trunk" ;
    dec:expectedOutputType "CodeChange" ;
    dec:compatibleGoals   "ship" , "land" .
