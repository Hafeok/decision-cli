# Bundled stream template `engineering-development`.
#
# FT-007 owns this asset. TC-001 drives
# `dec init --template engineering-development` through the FT-008
# init validation pipeline, which resolves
# `dec:terminalValueAction` against the bundled set (FT-007) and
# validates against the embedded base ontology (FT-006).
#
# The IRI is `stream:engineering-development`. Per §3.2 the stream's
# authorized goals must intersect the referenced ValueAction's
# `dec:compatibleGoals`; here both sides agree on `ship` and `land`.

@prefix dec:    <https://decision-cli.dev/ns#> .
@prefix va:     <https://decision-cli.dev/ns/value-actions/> .
@prefix stream: <https://decision-cli.dev/ns/streams/> .

stream:engineering-development a dec:ValueStream ;
    dec:name                "engineering-development" ;
    dec:title               "Engineering Development" ;
    dec:description         "Generic engineering-development value stream — terminates in shipped-feature." ;
    dec:terminalValueAction va:shipped-feature ;
    dec:authorizedGoals     "ship" , "land" .
