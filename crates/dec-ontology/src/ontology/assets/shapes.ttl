# SHACL shapes for the decision-cli base ontology.
#
# FT-006 / ADR-007: shipped embedded in the binary and exposed via
# `OntologyHandle::shapes_graph()` for the FT-008 init validation
# pipeline. The shapes encode the §5.3 invariants:
#
#   dec:ValueStream  → dec:name, dec:title, dec:terminalValueAction,
#                      dec:authorizedGoals (≥1)
#   dec:ValueAction  → dec:name, dec:description, dec:exitCriterion,
#                      dec:expectedOutputType, dec:compatibleGoals (≥1)

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# --- ValueStream shape -------------------------------------------------------

dec:ValueStreamShape a sh:NodeShape ;
    sh:targetClass dec:ValueStream ;

    sh:property [
        sh:path     dec:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueStream requires exactly one dec:name (string)."
    ] ;

    sh:property [
        sh:path     dec:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueStream requires exactly one dec:title (string)."
    ] ;

    sh:property [
        sh:path     dec:terminalValueAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:ValueStream requires exactly one dec:terminalValueAction (IRI)."
    ] ;

    sh:property [
        sh:path     dec:authorizedGoals ;
        sh:minCount 1 ;
        sh:message  "dec:ValueStream requires at least one dec:authorizedGoals entry."
    ] .

# --- ValueAction shape -------------------------------------------------------

dec:ValueActionShape a sh:NodeShape ;
    sh:targetClass dec:ValueAction ;

    sh:property [
        sh:path     dec:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueAction requires exactly one dec:name (string)."
    ] ;

    sh:property [
        sh:path     dec:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:ValueAction requires at least one dec:description."
    ] ;

    sh:property [
        sh:path     dec:exitCriterion ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:exitCriterion."
    ] ;

    sh:property [
        sh:path     dec:expectedOutputType ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:expectedOutputType."
    ] ;

    sh:property [
        sh:path     dec:compatibleGoals ;
        sh:minCount 1 ;
        sh:message  "dec:ValueAction requires at least one dec:compatibleGoals entry."
    ] .

# --- Role shape (FT-019) -----------------------------------------------------

dec:RoleShape a sh:NodeShape ;
    sh:targetClass dec:Role ;

    sh:property [
        sh:path     dec:roleId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Role requires exactly one dec:roleId (string)."
    ] ;

    sh:property [
        sh:path     dec:roleInputType ;
        sh:minCount 1 ;
        sh:message  "dec:Role requires at least one dec:roleInputType."
    ] ;

    sh:property [
        sh:path     dec:roleOutputType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Role requires exactly one dec:roleOutputType (IRI)."
    ] ;

    sh:property [
        sh:path     dec:roleModelBinding ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Role requires exactly one dec:roleModelBinding (string)."
    ] ;

    sh:property [
        sh:path     dec:authority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Role requires exactly one dec:authority link to a dec:Authority (ADR-027 / FT-030)."
    ] .

# --- Authority shape (FT-030 / ADR-027) --------------------------------------

dec:AuthorityShape a sh:NodeShape ;
    sh:targetClass dec:Authority ;

    sh:property [
        sh:path     dec:mayDecide ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Authority requires at least one dec:mayDecide category (ADR-027)."
    ] ;

    sh:property [
        sh:path     dec:mustEscalate ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Authority requires at least one dec:mustEscalate category (ADR-027)."
    ] ;

    sh:property [
        sh:path     dec:rationale ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Authority requires exactly one dec:rationale (string, ADR-027)."
    ] ;

    # mayDecide and mustEscalate must be disjoint (ADR-027 invariant).
    sh:sparql [
        sh:message "dec:mayDecide and dec:mustEscalate categories must be disjoint (ADR-027)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:mayDecide ?cat .
              $this dec:mustEscalate ?cat .
            }
        """
    ] ;

    # Every mustEscalate category must have at least one dec:escalateVia
    # entry naming it (ADR-027 invariant).
    sh:sparql [
        sh:message "every dec:mustEscalate category must have at least one dec:escalateVia entry (ADR-027)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:mustEscalate ?cat .
              FILTER NOT EXISTS {
                $this dec:escalateVia ?hint .
                ?hint dec:escalateCategory ?cat .
              }
            }
        """
    ] .

# --- DispatchGroup shape (FT-021 / ADR-017) ----------------------------------

dec:DispatchGroupShape a sh:NodeShape ;
    sh:targetClass dec:DispatchGroup ;

    sh:property [
        sh:path     dec:dispatchStatus ;
        sh:in       ( "awaiting-action"
                      "awaiting-interpretation"
                      "interpretation-running"
                      "interpretation-rejected"
                      "awaiting-amendment"
                      "action-failed"
                      "interpretation-failed"
                      "complete"
                      "paused-for-feedback"
                      "feedback-rejected-action-blocked" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:DispatchGroup requires exactly one dec:dispatchStatus from the enumerated lifecycle set (FT-021 / ADR-017 / FT-032 / ADR-025)."
    ] ;

    sh:property [
        sh:path     dec:dispatchedFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:DispatchGroup requires exactly one dec:dispatchedFor (the feature_spec id)."
    ] ;

    sh:property [
        sh:path     dec:hasActionSession ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:DispatchGroup requires exactly one dec:hasActionSession link (ADR-017)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:DispatchGroup requires exactly one dec:inStream link (ADR-005)."
    ] ;

    # FT-032 / ADR-025 — paused-for-feedback groups MUST carry at least
    # one dec:blockedBy link to the gating dec:Feedback. The constraint
    # only fires when dispatchStatus = "paused-for-feedback"; other
    # states are unaffected.
    sh:sparql [
        sh:message  "paused-for-feedback DispatchGroup requires at least one dec:blockedBy (FT-032 / ADR-025)" ;
        sh:select   """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:dispatchStatus "paused-for-feedback" .
              FILTER NOT EXISTS { $this dec:blockedBy ?fb }
            }
        """
    ] .

# --- VerificationVerdict shape (FT-020 / ADR-018) ---------------------------

dec:VerificationVerdictShape a sh:NodeShape ;
    sh:targetClass dec:VerificationVerdict ;

    sh:property [
        sh:path     dec:verdict ;
        sh:in       ( "approved" "rejected" "amendment-required" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one dec:verdict in {approved, rejected, amendment-required}."
    ] ;

    sh:property [
        sh:path      dec:rationale ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 20 ;
        sh:message   "dec:VerificationVerdict requires exactly one dec:rationale (string, ≥ 20 chars)."
    ] ;

    sh:property [
        sh:path     prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one prov:wasGeneratedBy (the InterpretationSession)."
    ] ;

    sh:property [
        sh:path     prov:used ;
        sh:minCount 1 ;
        sh:message  "dec:VerificationVerdict requires at least one prov:used (the action artifacts consumed)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict requires exactly one dec:inStream link (ADR-005)."
    ] ;

    sh:property [
        sh:path     dec:amendmentGuidance ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationVerdict carries at most one dec:amendmentGuidance (required iff verdict = amendment-required, enforced separately)."
    ] .

# --- Feedback shape (FT-026 / ADR-022) ---------------------------------------
# Enforces required-field cardinality per ADR-022. Class-specific vocabulary
# (sh:in for dec:feedbackClass) lands in FT-028; state-machine transitions
# land in FT-027.

dec:FeedbackShape a sh:NodeShape ;
    sh:targetClass dec:Feedback ;

    sh:property [
        sh:path     dec:feedbackClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "gap" "contradiction" "unimplementable"
                      "scope-issue" "defect" "capability-request" ) ;
        sh:message  "dec:Feedback requires exactly one dec:feedbackClass from the ADR-023 enumeration."
    ] ;

    sh:property [
        sh:path     dec:lifecycleState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "produced" "routed" "received"
                      "addressed" "closed" "rejected" "superseded" ) ;
        sh:message  "dec:Feedback requires exactly one dec:lifecycleState from the ADR-024 enumeration."
    ] ;

    sh:property [
        sh:path     dec:targetRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "dec:Feedback requires exactly one dec:targetRole (string, mirrors dec:roleId)."
    ] ;

    sh:property [
        sh:path      dec:evidence ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:Feedback requires exactly one non-empty dec:evidence (string)."
    ] ;

    sh:property [
        sh:path     dec:sourceSession ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Feedback requires exactly one dec:sourceSession (IRI)."
    ] ;

    sh:property [
        sh:path     dec:inStream ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Feedback requires exactly one dec:inStream link (ADR-005)."
    ] ;

    sh:property [
        sh:path     dec:severity ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:severity (string)."
    ] ;

    sh:property [
        sh:path     dec:recommendation ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:recommendation (string)."
    ] ;

    sh:property [
        sh:path     dec:sourceArtifact ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:sourceArtifact (IRI)."
    ] ;

    sh:property [
        sh:path     dec:addressingArtifact ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:addressingArtifact (IRI)."
    ] ;

    sh:property [
        sh:path     dec:rejectionReason ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:rejectionReason (string)."
    ] ;

    sh:property [
        sh:path     dec:supersededBy ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:supersededBy (IRI)."
    ] ;

    sh:property [
        sh:path     dec:dispositionOverride ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:Feedback carries at most one dec:dispositionOverride (string)."
    ] ;

    # --- Lifecycle companion-field constraints (ADR-024) ---------------
    # Each state requires its companion fields per ADR-024 §SHACL fragment.

    sh:sparql [
        sh:message "routed state requires dec:routedAt and dec:targetRole" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "routed" .
              FILTER NOT EXISTS { $this dec:routedAt ?t . $this dec:targetRole ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "received state requires dec:receivingSession" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "received" .
              FILTER NOT EXISTS { $this dec:receivingSession ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "addressed state requires dec:addressingArtifact" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "addressed" .
              FILTER NOT EXISTS { $this dec:addressingArtifact ?a }
            }
        """
    ] ;

    sh:sparql [
        sh:message "closed state requires dec:closedBy AND dec:addressingArtifact (PROV-O)" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "closed" .
              FILTER NOT EXISTS { $this dec:closedBy ?c . $this dec:addressingArtifact ?a }
            }
        """
    ] ;

    sh:sparql [
        sh:message "rejected state requires dec:rejectionReason" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "rejected" .
              FILTER NOT EXISTS { $this dec:rejectionReason ?r }
            }
        """
    ] ;

    sh:sparql [
        sh:message "superseded state requires dec:supersededBy" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:lifecycleState "superseded" .
              FILTER NOT EXISTS { $this dec:supersededBy ?s }
            }
        """
    ] .

# --- VerificationBench shape (FT-035 / ADR-028 / FT-112) --------------------
# Enforces ADR-028 §VerificationBench invariants (renamed from VerificationEnvironment by FT-112):
#   - dec:benchType is a non-empty string,
#   - dec:safetyClass ∈ {isolated, shared-non-destructive, production-readonly},
#   - dec:allowedOps is a non-empty rdf:List of operation tokens,
#   - dec:endpoint required iff dec:benchType matches the remote-type pattern.

dec:VerificationBenchShape a sh:NodeShape ;
    sh:targetClass dec:VerificationBench ;

    sh:property [
        sh:path      dec:benchType ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:VerificationBench requires exactly one non-empty dec:benchType (string)."
    ] ;

    sh:property [
        sh:path     dec:safetyClass ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "isolated" "shared-non-destructive" "production-readonly" ) ;
        sh:message  "dec:VerificationBench requires exactly one dec:safetyClass from {isolated, shared-non-destructive, production-readonly}."
    ] ;

    sh:property [
        sh:path     dec:allowedOps ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationBench requires exactly one dec:allowedOps rdf:List."
    ] ;

    sh:property [
        sh:path     dec:setup ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationBench carries at most one dec:setup (string)."
    ] ;

    sh:property [
        sh:path     dec:teardown ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationBench carries at most one dec:teardown (string)."
    ] ;

    sh:property [
        sh:path     dec:endpoint ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationBench carries at most one dec:endpoint (string)."
    ] ;

    # FT-053 / ADR-032: optional repo-relative fixture path.
    sh:property [
        sh:path      dec:fixtureSource ;
        sh:datatype  xsd:string ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:VerificationBench carries at most one non-empty dec:fixtureSource (string)."
    ] ;

    # Remote bench types (matching the remote-* prefix) must carry dec:endpoint.
    sh:sparql [
        sh:message "remote bench types (benchType starts with \"remote-\") require dec:endpoint" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:benchType ?t .
              FILTER(STRSTARTS(STR(?t), "remote-"))
              FILTER NOT EXISTS { $this dec:endpoint ?e }
            }
        """
    ] ;

    # Local bench types (benchType does NOT start with "remote-") must NOT carry dec:endpoint.
    sh:sparql [
        sh:message "local bench types (benchType does not start with \"remote-\") must NOT carry dec:endpoint" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:benchType ?t .
              FILTER(!STRSTARTS(STR(?t), "remote-"))
              $this dec:endpoint ?e .
            }
        """
    ] ;

    # allowedOps list must be non-empty (head is not rdf:nil).
    sh:sparql [
        sh:message "dec:allowedOps must be a non-empty rdf:List (head must not be rdf:nil)" ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
              $this dec:allowedOps rdf:nil .
            }
        """
    ] .

# --- VerificationGraph shape (FT-036 / ADR-028 / FT-112) --------------------
# Requires dec:verifies and dec:bench; dec:steps is an rdf:List
# (may be empty during authoring per FT-036 §Outputs).
# FT-112: renamed dec:environment to dec:bench.

dec:VerificationGraphShape a sh:NodeShape ;
    sh:targetClass dec:VerificationGraph ;

    sh:property [
        sh:path     dec:verifies ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:VerificationGraph requires exactly one dec:verifies (IRI of a feature or TC)."
    ] ;

    sh:property [
        sh:path     dec:bench ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:VerificationGraph requires exactly one dec:bench (IRI of a VerificationBench)."
    ] ;

    sh:property [
        sh:path     dec:steps ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:VerificationGraph requires exactly one dec:steps rdf:List head."
    ] .

# --- VerificationStep base shape (FT-036 / ADR-028) -------------------------
# Asserts the universal step invariants: every step has a stepType in the
# seed vocabulary, and (optionally) dec:providesEvidenceFor IRIs.

dec:VerificationStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;

    sh:property [
        sh:path     dec:stepType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "shell-command" "sparql-assertion" "file-assertion"
                      "http-request" "wait-for" "capture" ) ;
        sh:message  "dec:VerificationStep requires exactly one dec:stepType from the seed vocabulary (ADR-028)."
    ] ;

    sh:property [
        sh:path     dec:providesEvidenceFor ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:providesEvidenceFor entries (optional, multi-valued) must be IRIs."
    ] .

# --- Per-step-kind shapes (FT-036 / ADR-028) --------------------------------
# Each kind selects its target by the stepType literal via sh:sparql, and
# enforces the required fields for that kind. Optional fields are simply
# not listed (sh:maxCount 1 where applicable).

dec:ShellCommandStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "shell-command step requires dec:command (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "shell-command" .
              FILTER NOT EXISTS { $this dec:command ?c }
            }
        """
    ] .

dec:SparqlAssertionStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "sparql-assertion step requires dec:query (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "sparql-assertion" .
              FILTER NOT EXISTS { $this dec:query ?q }
            }
        """
    ] ;
    sh:sparql [
        sh:message "sparql-assertion step requires dec:target (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "sparql-assertion" .
              FILTER NOT EXISTS { $this dec:target ?t }
            }
        """
    ] .

dec:FileAssertionStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "file-assertion step requires dec:path (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "file-assertion" .
              FILTER NOT EXISTS { $this dec:path ?p }
            }
        """
    ] .

dec:HttpRequestStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "http-request step requires dec:url (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "http-request" .
              FILTER NOT EXISTS { $this dec:url ?u }
            }
        """
    ] ;
    sh:sparql [
        sh:message "http-request step requires dec:method (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "http-request" .
              FILTER NOT EXISTS { $this dec:method ?m }
            }
        """
    ] .

dec:WaitForStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "wait-for step requires dec:timeout (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "wait-for" .
              FILTER NOT EXISTS { $this dec:timeout ?t }
            }
        """
    ] ;
    sh:sparql [
        sh:message "wait-for step requires dec:condition (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "wait-for" .
              FILTER NOT EXISTS { $this dec:condition ?c }
            }
        """
    ] .

dec:CaptureStepShape a sh:NodeShape ;
    sh:targetClass dec:VerificationStep ;
    sh:sparql [
        sh:message "capture step requires dec:bindAs (ADR-028)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:stepType "capture" .
              FILTER NOT EXISTS { $this dec:bindAs ?b }
            }
        """
    ] .

# --- Capability shape (FT-054 / ADR-033) ------------------------------------
# Enforces ADR-033 §schema invariants on dec:Capability artifacts.
# Cardinality, datatype, and enum constraints are property shapes.
# Cross-field invariants (uniqueness, cache-cost pair) are sh:sparql.

dec:CapabilityShape a sh:NodeShape ;
    sh:targetClass dec:Capability ;

    sh:property [
        sh:path      dec:capability_id ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:Capability requires exactly one non-empty dec:capability_id (string)."
    ] ;

    sh:property [
        sh:path     dec:endpoint ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "scaleway" "anthropic" ) ;
        sh:message  "dec:Capability requires exactly one dec:endpoint in {scaleway, anthropic}."
    ] ;

    sh:property [
        sh:path      dec:model_identifier ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:Capability requires exactly one non-empty dec:model_identifier (string)."
    ] ;

    sh:property [
        sh:path         dec:tier ;
        sh:datatype     xsd:integer ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
        sh:message      "dec:tier (if present) must be an integer in 0..=3."
    ] ;

    sh:property [
        sh:path         dec:context_window ;
        sh:datatype     xsd:integer ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:Capability requires exactly one non-negative dec:context_window (integer)."
    ] ;

    sh:property [
        sh:path         dec:max_output ;
        sh:datatype     xsd:integer ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:Capability requires exactly one non-negative dec:max_output (integer)."
    ] ;

    sh:property [
        sh:path     dec:supports_vision ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Capability requires exactly one dec:supports_vision (boolean)."
    ] ;

    sh:property [
        sh:path     dec:supports_tool_calling ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:Capability requires exactly one dec:supports_tool_calling (boolean)."
    ] ;

    sh:property [
        sh:path         dec:cost_input_per_m ;
        sh:datatype     xsd:decimal ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:Capability requires exactly one non-negative dec:cost_input_per_m (decimal)."
    ] ;

    sh:property [
        sh:path         dec:cost_output_per_m ;
        sh:datatype     xsd:decimal ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:Capability requires exactly one non-negative dec:cost_output_per_m (decimal)."
    ] ;

    sh:property [
        sh:path         dec:cost_cache_hit_per_m ;
        sh:datatype     xsd:decimal ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:cost_cache_hit_per_m (if present) must be a non-negative decimal."
    ] ;

    sh:property [
        sh:path         dec:cost_cache_write_5m ;
        sh:datatype     xsd:decimal ;
        sh:maxCount     1 ;
        sh:minInclusive 0 ;
        sh:message      "dec:cost_cache_write_5m (if present) must be a non-negative decimal."
    ] ;

    sh:property [
        sh:path     dec:cost_currency ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "EUR" "USD" ) ;
        sh:message  "dec:Capability requires exactly one dec:cost_currency in {EUR, USD}."
    ] ;

    sh:property [
        sh:path     dec:configurable_effort ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message  "dec:configurable_effort (if present) must be a single boolean."
    ] ;

    sh:property [
        sh:path     dec:exposes_reasoning_trace ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message  "dec:exposes_reasoning_trace (if present) must be a single boolean."
    ] ;

    sh:property [
        sh:path     dec:status ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "active" "preview" "eol" "candidate" ) ;
        sh:message  "dec:Capability requires exactly one dec:status in {active, preview, eol, candidate}."
    ] ;

    sh:property [
        sh:path         dec:version ;
        sh:datatype     xsd:integer ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 1 ;
        sh:message      "dec:Capability requires exactly one dec:version (integer ≥ 1)."
    ] ;

    sh:property [
        sh:path     dec:supersedes ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:supersedes (if present) must be a single IRI."
    ] ;

    sh:property [
        sh:path     dec:bootstrap_source ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:bootstrap_source (if present) must be a single string."
    ] ;

    sh:property [
        sh:path     dec:notes ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:notes (if present) must be a single string."
    ] ;

    # FT-054 — (capability_id, version) must be unique within status=active.
    sh:sparql [
        sh:message "(capability_id, version) must be unique within status=active (FT-054 / ADR-033)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:capability_id ?id ;
                    dec:version ?v ;
                    dec:status "active" .
              ?other dec:capability_id ?id ;
                     dec:version ?v ;
                     dec:status "active" .
              FILTER ($this != ?other)
            }
        """
    ] ;

    # FT-054 — cache-cost pair invariant: both present or both absent.
    sh:sparql [
        sh:message "dec:cost_cache_hit_per_m and dec:cost_cache_write_5m must be paired (both present or both absent, FT-054 / ADR-033)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              {
                $this dec:cost_cache_hit_per_m ?h .
                FILTER NOT EXISTS { $this dec:cost_cache_write_5m ?w }
              } UNION {
                $this dec:cost_cache_write_5m ?w .
                FILTER NOT EXISTS { $this dec:cost_cache_hit_per_m ?h }
              }
            }
        """
    ] .

# --- RoleBinding shape (FT-055 / ADR-033 / ADR-034) -------------------------
# Cardinality and datatype invariants for dec:RoleBinding. Cross-subject
# invariants (at-most-one-active per role_id, default_capability not EOL)
# are sh:sparql.

dec:RoleBindingShape a sh:NodeShape ;
    sh:targetClass dec:RoleBinding ;

    sh:property [
        sh:path      dec:role_id ;
        sh:datatype  xsd:string ;
        sh:minCount  1 ;
        sh:maxCount  1 ;
        sh:minLength 1 ;
        sh:message   "dec:RoleBinding requires exactly one non-empty dec:role_id (string)."
    ] ;

    sh:property [
        sh:path     dec:default_capability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:RoleBinding requires exactly one dec:default_capability (IRI of a dec:Capability)."
    ] ;

    sh:property [
        sh:path     dec:active ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message  "dec:RoleBinding requires exactly one dec:active (boolean)."
    ] ;

    sh:property [
        sh:path         dec:version ;
        sh:datatype     xsd:integer ;
        sh:minCount     1 ;
        sh:maxCount     1 ;
        sh:minInclusive 1 ;
        sh:message      "dec:RoleBinding requires exactly one dec:version (integer ≥ 1)."
    ] ;

    sh:property [
        sh:path     dec:escalation_steps ;
        sh:maxCount 1 ;
        sh:message  "dec:RoleBinding carries at most one dec:escalation_steps rdf:List head."
    ] ;

    sh:property [
        sh:path     dec:supersedes ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message  "dec:supersedes (if present) must be a single IRI."
    ] ;

    sh:property [
        sh:path     dec:bootstrap_source ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message  "dec:bootstrap_source (if present) must be a single string."
    ] ;

    # At most one active binding per role_id (FT-055 invariant).
    sh:sparql [
        sh:message "at most one dec:RoleBinding may carry dec:active=true per dec:role_id (FT-055)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:role_id ?r ;
                    dec:active true .
              ?other a dec:RoleBinding ;
                     dec:role_id ?r ;
                     dec:active true .
              FILTER ($this != ?other)
            }
        """
    ] ;

    # default_capability MUST reference a capability whose status ≠ eol.
    sh:sparql [
        sh:message "dec:default_capability MUST reference a dec:Capability whose dec:status is not \"eol\" (FT-055 / ADR-033)." ;
        sh:select """
            PREFIX dec: <https://decision-cli.dev/ns#>
            SELECT $this WHERE {
              $this dec:default_capability ?cap .
              ?cap dec:status "eol" .
            }
        """
    ] .

# --- EscalationStep shape (FT-055 / ADR-034) --------------------------------

dec:EscalationStepShape a sh:NodeShape ;
    sh:targetClass dec:EscalationStep ;

    sh:property [
        sh:path     dec:step_capability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:EscalationStep requires exactly one dec:step_capability (IRI of a dec:Capability)."
    ] ;

    sh:property [
        sh:path     dec:triggers ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:EscalationStep requires at least one dec:triggers entry (IRI of a dec:EscalationTrigger)."
    ] .

# --- Bundle shape (FT-056 / ADR-035) ----------------------------------------
# Enforces ADR-035 §"Who sets it" invariant: every dec:Bundle carries
# exactly one dec:stakes literal drawn from {routine, elevated, foundational}.

dec:BundleShape a sh:NodeShape ;
    sh:targetClass dec:Bundle ;

    sh:property [
        sh:path     dec:stakes ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "routine" "elevated" "foundational" ) ;
        sh:message  "dec:Bundle requires exactly one dec:stakes literal in {routine, elevated, foundational} (ADR-035)."
    ] .

# --- EscalationTrigger shape (FT-055 / ADR-034) -----------------------------

dec:EscalationTriggerShape a sh:NodeShape ;
    sh:targetClass dec:EscalationTrigger ;

    sh:property [
        sh:path     dec:trigger_signal ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in       ( "stakes_routine"
                      "stakes_elevated"
                      "stakes_foundational"
                      "confidence_below_0.5"
                      "confidence_below_0.7"
                      "confidence_below_0.9"
                      "audit_pass"
                      "audit_fail"
                      "prior_attempts_ge_1"
                      "prior_attempts_ge_2"
                      "prior_attempts_ge_3"
                      "prior_attempts_ge_4"
                      "prior_attempts_ge_5"
                      "feedback_contradiction"
                      "feedback_unimplementable_critical"
                      "feedback_gap"
                      "feedback_scope_issue" ) ;
        sh:message  "dec:EscalationTrigger requires exactly one dec:trigger_signal drawn from the ADR-034 closed vocabulary."
    ] .

# --- SessionRecord shape (FT-057 / ADR-034 / ADR-037) -----------------------
# Six new properties carry escalation chain membership + cache-aware token
# breakdown. Three sh:sparql-style consistency constraints enforce:
#   1. bidirectional escalation linkage (S1->S2 implies S2->S1)
#   2. escalation_reason present iff escalated_from present
#   3. Scaleway sessions carry zero cache-write/cache-hit token counts.
# The Rust validator implements the sh:sparql checks; this TTL declares the
# property cardinalities so the embedded shapes graph stays introspectable.

dec:SessionRecordShape a sh:NodeShape ;
    sh:targetClass dec:Session ;

    sh:property [
        sh:path     dec:escalated_from ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Session may carry at most one dec:escalated_from (FT-057)."
    ] ;

    sh:property [
        sh:path     dec:escalated_to ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message  "dec:Session may carry at most one dec:escalated_to (FT-057)."
    ] ;

    sh:property [
        sh:path     dec:escalation_reason ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in       ( "stakes_routine"
                      "stakes_elevated"
                      "stakes_foundational"
                      "confidence_below_0.5"
                      "confidence_below_0.7"
                      "confidence_below_0.9"
                      "audit_pass"
                      "audit_fail"
                      "prior_attempts_ge_1"
                      "prior_attempts_ge_2"
                      "prior_attempts_ge_3"
                      "prior_attempts_ge_4"
                      "prior_attempts_ge_5"
                      "feedback_contradiction"
                      "feedback_unimplementable_critical"
                      "feedback_gap"
                      "feedback_scope_issue" ) ;
        sh:message  "dec:Session dec:escalation_reason must be drawn from the ADR-034 trigger vocabulary."
    ] ;

    sh:property [
        sh:path         dec:input_tokens_base ;
        sh:datatype     xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount     1 ;
        sh:message      "dec:Session dec:input_tokens_base must be a non-negative integer."
    ] ;

    sh:property [
        sh:path         dec:input_tokens_cache_write ;
        sh:datatype     xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount     1 ;
        sh:message      "dec:Session dec:input_tokens_cache_write must be a non-negative integer."
    ] ;

    sh:property [
        sh:path         dec:input_tokens_cache_hit ;
        sh:datatype     xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount     1 ;
        sh:message      "dec:Session dec:input_tokens_cache_hit must be a non-negative integer."
    ] ;

    sh:property [
        sh:path         dec:output_tokens ;
        sh:datatype     xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount     1 ;
        sh:message      "dec:Session dec:output_tokens must be a non-negative integer."
    ] .
