# Per-type provenance composition shape for dec:WorkerImage (FT-072 / ADR-038 / ADR-055).
#
# WorkerImages enter the catalog through one of three routes:
#   * Boundary — CI-built and posted from outside the orchestration
#                graph (ADR-055 / the worker-distribution Brief).
#   * Addressing a Feedback — a worker built to resolve a specific gap.
#   * Decomposing a Brief — a worker authored to implement a Brief's
#     decomposition.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:WorkerImageShape a sh:NodeShape ;
    sh:targetClass dec:WorkerImage ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:addresses      ; sh:minCount 1 ; sh:class dec:Feedback ] ]
        [ sh:property [ sh:path dec:decomposesFrom ; sh:minCount 1 ; sh:class dec:Brief    ] ]
    ) .
