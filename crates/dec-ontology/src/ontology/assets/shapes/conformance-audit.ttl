# Per-type provenance composition shape for dec:ConformanceAudit (FT-072 / ADR-038 / ADR-055).
#
# A ConformanceAudit always audits a specific WorkerImage. The
# motivational origin is the audited image. Boundary instances (e.g.
# audits posted by external CI) satisfy the sh:or via the BoundaryArtifact
# branch.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:ConformanceAuditShape a sh:NodeShape ;
    sh:targetClass dec:ConformanceAudit ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:audits ; sh:minCount 1 ; sh:class dec:WorkerImage ] ]
    ) .
