# Per-type provenance composition shape for dec:Question (FT-072 / ADR-038).
#
# A Question's motivational origin is either the Session in which it was
# raised, or the Brief / ADR that raised it. The :raisedBy predicate's
# range is left to per-type shapes per FT-070.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:QuestionShape a sh:NodeShape ;
    sh:targetClass dec:Question ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:raisedIn ; sh:minCount 1 ; sh:class dec:Session ] ]
        [ sh:property [ sh:path dec:raisedBy ; sh:minCount 1 ; sh:class dec:Brief   ] ]
        [ sh:property [ sh:path dec:raisedBy ; sh:minCount 1 ; sh:class dec:ADR     ] ]
    ) .
