# Per-type provenance composition shape for dec:TC (FT-072 / ADR-038).
#
# A TC's motivational origin is the artifact it validates — either a
# Feature or an ADR. The vocabulary's :validates predicate carries both
# possibilities (range is left to the per-type shape per FT-070).

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:TCShape a sh:NodeShape ;
    sh:targetClass dec:TC ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:validates ; sh:minCount 1 ; sh:class dec:Feature ] ]
        [ sh:property [ sh:path dec:validates ; sh:minCount 1 ; sh:class dec:ADR     ] ]
    ) .
