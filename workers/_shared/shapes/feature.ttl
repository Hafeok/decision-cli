# Per-type provenance composition shape for dec:Feature (FT-072 / ADR-038).
#
# Composes the dual-provenance discipline (ADR-038) for the Feature
# artifact type:
#   * sh:and    → the universal mechanical-provenance fragment (FT-069).
#   * sh:or     → BoundaryArtifact escape hatch first, then the
#                 motivational alternatives drawn from FT-070's catalog.
#
# This file ships only the provenance composition; any field-level
# constraints on Feature (title, status, …) layer on top through
# additional sh:NodeShape declarations elsewhere — both shapes apply.

@prefix dec:  <https://decision-cli.dev/ns#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

dec:FeatureShape a sh:NodeShape ;
    sh:targetClass dec:Feature ;
    sh:and ( dec:MechanicalProvenanceShape ) ;
    sh:or (
        [ a sh:NodeShape ; sh:class dec:BoundaryArtifact ]
        [ sh:property [ sh:path dec:addresses        ; sh:minCount 1 ; sh:class dec:Feedback         ] ]
        [ sh:property [ sh:path dec:decomposesFrom   ; sh:minCount 1 ; sh:class dec:Brief            ] ]
        [ sh:property [ sh:path dec:originatedFrom   ; sh:minCount 1 ; sh:class dec:DiscoveryFinding ] ]
        [ sh:property [ sh:path dec:respondsTo       ; sh:minCount 1 ; sh:class dec:Question         ] ]
    ) .
