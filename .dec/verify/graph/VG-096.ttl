# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-096>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-026> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-096/0> <https://decision-cli.dev/ns/step/VG-096/1> <https://decision-cli.dev/ns/step/VG-096/2> ) .

<https://decision-cli.dev/ns/step/VG-096/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-096/1>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:path "core/ontology/feedback.ttl" ;
    dec:expectContent "dec:Feedback" .

<https://decision-cli.dev/ns/step/VG-096/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?class (COUNT(?feedback) AS ?count) WHERE { ?feedback a dec:Feedback ; dec:feedbackClass ?class . } GROUP BY ?class" ;
    dec:expectRows 1 .
