# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-038>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-053> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-038/0> <https://decision-cli.dev/ns/step/VG-038/1> <https://decision-cli.dev/ns/step/VG-038/2> <https://decision-cli.dev/ns/step/VG-038/3> <https://decision-cli.dev/ns/step/VG-038/4> ) .

<https://decision-cli.dev/ns/step/VG-038/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p ./test_fixture_dir" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-038/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-097> ;
    dec:command "dec verify env new --id test_env --safety-class isolated --fixture-source ./test_fixture_dir" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-038/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-099> ;
    dec:command "dec verify env show --id test_env" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-038/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-098> ;
    dec:command "dec verify env list" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-038/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-097> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?s ?p ?o WHERE { ?s ?p ?o . FILTER(?p = dec:fixtureSource) }" .
