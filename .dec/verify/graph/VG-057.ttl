# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-057>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-069> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-057/0> <https://decision-cli.dev/ns/step/VG-057/1> <https://decision-cli.dev/ns/step/VG-057/2> <https://decision-cli.dev/ns/step/VG-057/3> ) .

<https://decision-cli.dev/ns/step/VG-057/0>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-119> ;
    dec:path "crates/decision-cli/src/core/ontology/shapes/mechanical-provenance.ttl" .

<https://decision-cli.dev/ns/step/VG-057/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-119> ;
    dec:command "cd crates/decision-cli && cargo build" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-057/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-119> ;
    dec:command "dec init --workdir /tmp/test-workdir" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-057/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-119> ;
    dec:target "/tmp/test-workdir/.dec/store" ;
    dec:query "PREFIX sh: <http://www.w3.org/ns/shacl#>\nPREFIX dec: <https://decision-cli.dev/ns#>\nSELECT ?shape WHERE { ?shape a sh:NodeShape . FILTER(STRSTARTS(STR(?shape), STR(dec:))) }" .
