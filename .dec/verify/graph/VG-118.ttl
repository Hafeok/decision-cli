@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-118>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-012> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-118/0> <https://decision-cli.dev/ns/step/VG-118/1> <https://decision-cli.dev/ns/step/VG-118/2> <https://decision-cli.dev/ns/step/VG-118/3> <https://decision-cli.dev/ns/step/VG-118/4> <https://decision-cli.dev/ns/step/VG-118/5> ) .

<https://decision-cli.dev/ns/step/VG-118/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-118/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-006> ;
    dec:command "dec status" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-118/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-007> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?session WHERE { GRAPH ?g { ?session a dec:Session ; dec:inStream <decision-cli-development> . } }" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-118/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:command "dec implement FT-XXX" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-118/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?session WHERE { GRAPH ?g { ?session a dec:Session ; dec:inStream <decision-cli-development> . } }" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-118/5>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:target ".product/graph/index.ttl" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?codechange WHERE { GRAPH ?g { ?codechange a dec:CodeChange . } }" ;
    dec:expectRows 1 .
