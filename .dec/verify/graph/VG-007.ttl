# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-007>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-003> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-007/0> <https://decision-cli.dev/ns/step/VG-007/1> <https://decision-cli.dev/ns/step/VG-007/2> ) .

<https://decision-cli.dev/ns/step/VG-007/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-009> ;
    dec:command "cargo test --lib event_emission" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-007/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-010> ;
    dec:command "cargo test --lib event_outbox" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-007/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-011> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX oxi: <https://decision-cli.dev/ns/oxi#> PREFIX prov: <http://www.w3.org/ns/prov#> SELECT ?event ?seq ?subscription ?delta ?generatedBy WHERE { ?event a oxi:Event ; oxi:sequence ?seq ; oxi:subscription ?subscription ; oxi:delta ?delta ; prov:wasGeneratedBy ?generatedBy . }" .
