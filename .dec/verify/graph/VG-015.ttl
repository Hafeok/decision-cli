# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-015>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-026> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-015/0> <https://decision-cli.dev/ns/step/VG-015/1> <https://decision-cli.dev/ns/step/VG-015/2> <https://decision-cli.dev/ns/step/VG-015/3> <https://decision-cli.dev/ns/step/VG-015/4> ) .

<https://decision-cli.dev/ns/step/VG-015/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:command "find . -name \"feedback.ttl\" -type f" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-015/1>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:path "core/ontology/feedback.ttl" .

<https://decision-cli.dev/ns/step/VG-015/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:command "cargo test --lib feedback" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-015/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://w3id.org/oxi/dec#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?class WHERE { ?class rdfs:subClassOf dec:Feedback . }" .

<https://decision-cli.dev/ns/step/VG-015/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-040> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dec: <https://w3id.org/oxi/dec#> SELECT ?shape WHERE { ?shape a sh:NodeShape . ?shape sh:targetClass dec:Feedback . }" .
