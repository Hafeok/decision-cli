# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-067>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-079> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-067/0> <https://decision-cli.dev/ns/step/VG-067/1> <https://decision-cli.dev/ns/step/VG-067/2> ) .

<https://decision-cli.dev/ns/step/VG-067/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-067/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .dec/store/bundle.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-067/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-144> ;
    dec:target ".dec/store/bundle.ttl" ;
    dec:query "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX dec: <https://decisionframework.dev/ns/>\n\nSELECT ?s ?p ?o WHERE { ?s ?p ?o }" .
