<https://decision-cli.dev/ns/step/VG-028/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-051> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns/> SELECT ?graph ?verifies ?environment ?stepCount WHERE { ?graph a dec:VerificationGraph ; dec:verifies ?verifies ; dec:targetsEnvironment ?environment ; dec:stepCount ?stepCount . } ORDER BY ?graph" .

