<https://decision-cli.dev/ns/graph/VG-028>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-042> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-028/0> <https://decision-cli.dev/ns/step/VG-028/1> <https://decision-cli.dev/ns/step/VG-028/2> <https://decision-cli.dev/ns/step/VG-028/3> <https://decision-cli.dev/ns/step/VG-028/4> <https://decision-cli.dev/ns/step/VG-028/5> <https://decision-cli.dev/ns/step/VG-028/6> <https://decision-cli.dev/ns/step/VG-028/7> <https://decision-cli.dev/ns/step/VG-028/8> <https://decision-cli.dev/ns/step/VG-028/9> ) .

<https://decision-cli.dev/ns/step/VG-028/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-028/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec verify graph create --id VG-001 --verifies FT-038 --environment ENV-002 --steps 3" ;
