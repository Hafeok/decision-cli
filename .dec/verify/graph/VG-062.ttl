# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-062>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-074> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-062/0> <https://decision-cli.dev/ns/step/VG-062/1> <https://decision-cli.dev/ns/step/VG-062/2> <https://decision-cli.dev/ns/step/VG-062/3> <https://decision-cli.dev/ns/step/VG-062/4> <https://decision-cli.dev/ns/step/VG-062/5> ) .

<https://decision-cli.dev/ns/step/VG-062/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .product/.migrations" .

<https://decision-cli.dev/ns/step/VG-062/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .product/feature1.md .product/adr1.md .product/tc1.md .product/dependency1.md" .

<https://decision-cli.dev/ns/step/VG-062/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-124> ;
    dec:command "dec migrate provenance --dry-run" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-062/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-124> ;
    dec:command "ls -la .product/.migrations/" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-062/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-124> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX prov: <http://www.w3.org/ns/prov#> PREFIX : <http://example.org/> SELECT ?s ?p ?o WHERE { ?s ?p ?o . FILTER(?p = prov:wasGeneratedBy || ?p = prov:wasAttributedTo) }" .

<https://decision-cli.dev/ns/step/VG-062/5>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-124> ;
    dec:path ".product/.migrations/provenance-*.json" .
