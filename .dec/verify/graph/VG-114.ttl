# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-114>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-012> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-114/0> <https://decision-cli.dev/ns/step/VG-114/1> <https://decision-cli.dev/ns/step/VG-114/2> <https://decision-cli.dev/ns/step/VG-114/3> <https://decision-cli.dev/ns/step/VG-114/4> ) .

<https://decision-cli.dev/ns/step/VG-114/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template decision-cli-development" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-114/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-006> ;
    dec:command "dec status" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-114/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-007> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?session WHERE { GRAPH ?g { ?session a dec:Session ; dec:inStream ?stream . ?stream dec:streamId \"decision-cli-development\" . } }" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-114/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:command "dec implement FT-XXX" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-114/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> PREFIX prov: <http://www.w3.org/ns/prov#> SELECT ?session ?codechange WHERE { GRAPH ?g { ?session a dec:Session ; dec:inStream ?stream . ?stream dec:streamId \"decision-cli-development\" . ?codechange a dec:CodeChange ; prov:wasGeneratedBy ?session . } }" ;
    dec:expectRows 1 .
