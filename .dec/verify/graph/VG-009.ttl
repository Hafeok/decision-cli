@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-009>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-009> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-009/0> <https://decision-cli.dev/ns/step/VG-009/1> <https://decision-cli.dev/ns/step/VG-009/2> <https://decision-cli.dev/ns/step/VG-009/3> <https://decision-cli.dev/ns/step/VG-009/4> ) .

<https://decision-cli.dev/ns/step/VG-009/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-001> ;
    dec:command "mkdir -p test-workspace && cd test-workspace && dec init --no-git" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-009/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-002> ;
    dec:command "cd test-workspace && dec doctor --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-009/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec doctor --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-009/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-015> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX dec: <https://decision-cli.dev/ns/>\nSELECT ?s ?p ?o WHERE { ?s ?p ?o . }" .

<https://decision-cli.dev/ns/step/VG-009/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-019> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX dec: <https://decision-cli.dev/ns/>\nSELECT ?s ?p ?o WHERE { ?s ?p ?o . }\nLIMIT 10" .
