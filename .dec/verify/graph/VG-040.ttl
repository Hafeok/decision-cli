# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-040>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-055> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-040/0> <https://decision-cli.dev/ns/step/VG-040/1> <https://decision-cli.dev/ns/step/VG-040/2> <https://decision-cli.dev/ns/step/VG-040/3> <https://decision-cli.dev/ns/step/VG-040/4> ) .

<https://decision-cli.dev/ns/step/VG-040/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cargo build --release" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-040/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec doctor --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-040/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-101> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decisionframework.org/ontology#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?class WHERE { ?class a sh:NodeShape . ?class sh:targetClass dec:RoleBinding . }" .

<https://decision-cli.dev/ns/step/VG-040/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-101> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decisionframework.org/ontology#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?class WHERE { ?class a sh:NodeShape . ?class sh:targetClass dec:EscalationStep . }" .

<https://decision-cli.dev/ns/step/VG-040/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-101> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decisionframework.org/ontology#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?class WHERE { ?class a sh:NodeShape . ?class sh:targetClass dec:EscalationTrigger . }" .
