# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-078>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-090> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-078/0> <https://decision-cli.dev/ns/step/VG-078/1> <https://decision-cli.dev/ns/step/VG-078/2> <https://decision-cli.dev/ns/step/VG-078/3> ) .

<https://decision-cli.dev/ns/step/VG-078/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-078/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .dec/store/worker-image-submission.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-078/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-132> ;
    dec:command "echo 'valid' > .dec/signature-verdict.txt" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-078/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-132> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX prov: <http://www.w3.org/ns/prov#>\nPREFIX dec: <https://decision-objects.org/dec#>\nSELECT ?verdict WHERE { ?verdict a dec:SignatureVerdict . ?verdict dec:verdictClass 'valid' . }" .
