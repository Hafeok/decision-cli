# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-091>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-009> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-091/0> <https://decision-cli.dev/ns/step/VG-091/1> <https://decision-cli.dev/ns/step/VG-091/2> <https://decision-cli.dev/ns/step/VG-091/3> <https://decision-cli.dev/ns/step/VG-091/4> ) .

<https://decision-cli.dev/ns/step/VG-091/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-091/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .dec/config.toml" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-091/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-001> ;
    dec:command "dec init --working-dir ." ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-091/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-015> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-002> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX dec: <https://decision-cli.dev/ns/>\nSELECT ?s ?p ?o WHERE { ?s ?p ?o . }" .

<https://decision-cli.dev/ns/step/VG-091/4>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-019> ;
    dec:path ".dec/store" .
