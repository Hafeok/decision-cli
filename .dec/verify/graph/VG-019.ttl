# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-019>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-032> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-019/0> <https://decision-cli.dev/ns/step/VG-019/1> <https://decision-cli.dev/ns/step/VG-019/2> <https://decision-cli.dev/ns/step/VG-019/3> <https://decision-cli.dev/ns/step/VG-019/4> ) .

<https://decision-cli.dev/ns/step/VG-019/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-036> ;
    dec:command "cargo test --lib dispatch::pause_on_feedback" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-019/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-037> ;
    dec:command "cargo test --lib dispatch::resume_check" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-019/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-036> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?group WHERE { ?group a dec:DispatchGroup ; dec:dispatchStatus \"paused-for-feedback\" . }" .

<https://decision-cli.dev/ns/step/VG-019/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-037> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?group WHERE { ?group a dec:DispatchGroup ; dec:dispatchStatus \"feedback-rejected-action-blocked\" . }" .

<https://decision-cli.dev/ns/step/VG-019/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-036> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?group ?feedback WHERE { ?group a dec:DispatchGroup ; dec:blockedBy ?feedback . ?feedback dec:lifecycleState ?state . FILTER(?state IN (\"addressed\", \"rejected\", \"closed\")) }" .
