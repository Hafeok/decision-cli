# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-092>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-019> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-092/0> <https://decision-cli.dev/ns/step/VG-092/1> <https://decision-cli.dev/ns/step/VG-092/2> ) .

<https://decision-cli.dev/ns/step/VG-092/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-092/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-027> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?role WHERE { ?role a dec:Role ; dec:roleId \"verifier\" . }" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-092/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-088> ;
    dec:command "dec verify feature --feature-id FT-019" ;
    dec:expectExitCode 0 .
