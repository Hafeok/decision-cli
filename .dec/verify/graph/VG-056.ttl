# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-056>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-068> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-056/0> <https://decision-cli.dev/ns/step/VG-056/1> <https://decision-cli.dev/ns/step/VG-056/2> ) .

<https://decision-cli.dev/ns/step/VG-056/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --workdir ." ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-056/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-140> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns/> PREFIX rdfs: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT ?role WHERE { ?role a dec:Role ; dec:roleId \"verify-graph-author\" . }" .

<https://decision-cli.dev/ns/step/VG-056/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-140> ;
    dec:command "dec verify graph generate --feature-id FT-068 --env BNCH-002 --workdir ." ;
    dec:expectExitCode 0 .
