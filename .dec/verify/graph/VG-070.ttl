# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-070>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-082> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-070/0> <https://decision-cli.dev/ns/step/VG-070/1> ) .

<https://decision-cli.dev/ns/step/VG-070/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-147> ;
    dec:command "cargo test --package pipeline-worker-sdk --test side_channel_tests" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-070/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-147> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX prov: <http://www.w3.org/ns/prov#>\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX dec: <https://decisionframework.org/dec#>\n\nSELECT ?judgment WHERE { ?judgment a dec:EmergentJudgment . }" .
