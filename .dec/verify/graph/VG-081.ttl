<https://decision-cli.dev/ns/step/VG-081/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-135> ;
    dec:command "mkdir -p /tmp/test-workspace && cd /tmp/test-workspace && echo '[worker]\\nname = \"test-worker\"\\nsdk_version = \"0.3.0\"\\nwire_protocol = \"1.0\"\\n\\n[capabilities]\\ntags = [\"code-writer\"]\\ncompatible_roles = [\"engineering.implementer\"]\\n\\n[runtime]\\nkind = \"subscribed\"\\nentrypoint = \"test-worker.main:run\"' > worker.toml" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-081/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd /tmp/test-workspace && mkdir -p .dec/store && touch .dec/store/test-store.ttl" ;
