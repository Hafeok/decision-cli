    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-081/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd /tmp/test-workspace && echo '{\"registry_ref\": \"ghcr.io/test/test-worker:v1.0.0\", \"capability_tags\": [\"code-writer\"], \"compatible_roles\": [\"engineering.implementer\"], \"sbom_ref\": \"sbom-ref\", \"signed_by\": \"test@example.com\", \"provenance\": \"mock-provenance\"}' > submission.json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-081/5>
    a dec:VerificationStep ;
