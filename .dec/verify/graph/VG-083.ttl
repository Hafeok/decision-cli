<https://decision-cli.dev/ns/graph/VG-083>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-095> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-083/0> <https://decision-cli.dev/ns/step/VG-083/1> <https://decision-cli.dev/ns/step/VG-083/2> <https://decision-cli.dev/ns/step/VG-083/3> <https://decision-cli.dev/ns/step/VG-083/4> <https://decision-cli.dev/ns/step/VG-083/5> <https://decision-cli.dev/ns/step/VG-083/6> <https://decision-cli.dev/ns/step/VG-083/7> ) .

<https://decision-cli.dev/ns/step/VG-083/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p ~/.pipeline-cli" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-083/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "echo \"PIPELINE_ENDPOINT=http://localhost:8080\" > ~/.pipeline-cli/workers.env && echo \"PIPELINE_TOKEN=token123\" >> ~/.pipeline-cli/workers.env && echo \"LITELLM_BASE_URL=http://localhost:4000\" >> ~/.pipeline-cli/workers.env && echo \"LITELLM_API_KEY=key123\" >> ~/.pipeline-cli/workers.env" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-083/2>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-137> ;
    dec:path "~/.pipeline-cli/workers.env" .

<https://decision-cli.dev/ns/step/VG-083/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-137> ;
    dec:command "echo \"Testing successful run with qualified image\"" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-083/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-137> ;
    dec:command "echo \"Testing error case: missing PIPELINE_ENDPOINT\"" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-083/5>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "rm ~/.pipeline-cli/workers.env && echo \"PIPELINE_TOKEN=token123\" > ~/.pipeline-cli/workers.env && echo \"LITELLM_BASE_URL=http://localhost:4000\" >> ~/.pipeline-cli/workers.env && echo \"LITELLM_API_KEY=key123\" >> ~/.pipeline-cli/workers.env" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-083/6>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-137> ;
    dec:path "~/.pipeline-cli/workers.env" .

<https://decision-cli.dev/ns/step/VG-083/7>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-137> ;
    dec:command "echo \"Testing error case: non-qualified image ID\"" ;
