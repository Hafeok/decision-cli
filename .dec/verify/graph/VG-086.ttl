# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-086>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-098> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-001> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-086/0> <https://decision-cli.dev/ns/step/VG-086/1> <https://decision-cli.dev/ns/step/VG-086/2> <https://decision-cli.dev/ns/step/VG-086/3> <https://decision-cli.dev/ns/step/VG-086/4> ) .

<https://decision-cli.dev/ns/step/VG-086/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-086/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-154> ;
    dec:command "touch .dec/store/test-data.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-086/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-155> ;
    dec:target ".dec/store/test-data.ttl" ;
    dec:query "PREFIX dc: <http://purl.org/dc/terms/> PREFIX dec: <https://decisionframework.org/ns/dec#> SELECT ?s ?p ?o WHERE { ?s ?p ?o . }" .

<https://decision-cli.dev/ns/step/VG-086/3>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-156> ;
    dec:path ".dec/store/test-data.ttl" .

<https://decision-cli.dev/ns/step/VG-086/4>
    a dec:VerificationStep ;
    dec:stepType "capture" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-157> ;
    dec:bindAs "test_output" .
