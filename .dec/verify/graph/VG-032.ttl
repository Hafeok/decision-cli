# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-032>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-046> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-032/0> <https://decision-cli.dev/ns/step/VG-032/1> <https://decision-cli.dev/ns/step/VG-032/2> <https://decision-cli.dev/ns/step/VG-032/3> <https://decision-cli.dev/ns/step/VG-032/4> ) .

<https://decision-cli.dev/ns/step/VG-032/0>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://w3id.org/oxigraph/dec#> SELECT ?tc WHERE { ?tc a dec:TestCriterion . }" .

<https://decision-cli.dev/ns/step/VG-032/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://w3id.org/oxigraph/dec#> SELECT ?graph WHERE { ?graph a dec:VerificationGraph . ?graph dec:bench <BNCH-002> . }" .

<https://decision-cli.dev/ns/step/VG-032/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-070> ;
    dec:command "dec doctor --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-032/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-071> ;
    dec:command "dec version" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-032/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-072> ;
    dec:command "dec help" ;
    dec:expectExitCode 0 .
