# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-050>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-067> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-050/0> <https://decision-cli.dev/ns/step/VG-050/1> <https://decision-cli.dev/ns/step/VG-050/2> <https://decision-cli.dev/ns/step/VG-050/3> <https://decision-cli.dev/ns/step/VG-050/4> ) .

<https://decision-cli.dev/ns/step/VG-050/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cat crates/decision-cli/src/core/worker/assets/manifest.toml" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-050/1>
    a dec:VerificationStep ;
    dec:stepType "capture" ;
    dec:bindAs "manifest_content" .

<https://decision-cli.dev/ns/step/VG-050/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-050> ;
    dec:command "grep -q 'role = \"verify-graph-author\"' crates/decision-cli/src/core/worker/assets/manifest.toml && echo 'Found' || echo 'Not found'" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-050/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-046> ;
    dec:command "dec doctor --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-050/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec verify graph generate FT-067 --environment ENV-002" ;
    dec:expectExitCode 0 .
