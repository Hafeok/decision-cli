# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-013>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-024> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-013/0> <https://decision-cli.dev/ns/step/VG-013/1> <https://decision-cli.dev/ns/step/VG-013/2> <https://decision-cli.dev/ns/step/VG-013/3> <https://decision-cli.dev/ns/step/VG-013/4> ) .

<https://decision-cli.dev/ns/step/VG-013/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-013/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .dec/store/test-data.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-013/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-032> ;
    dec:target ".dec/store/test-data.ttl" ;
    dec:query "PREFIX prov: <http://www.w3.org/ns/prov#>\nPREFIX dec: <https://decisionframework.org/dec#>\nSELECT ?group WHERE { ?group a dec:DispatchGroup . }" .

<https://decision-cli.dev/ns/step/VG-013/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-032> ;
    dec:command "cargo test --lib metrics::agreement" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-013/4>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-032> ;
    dec:path ".dec/metrics_output.json" .
