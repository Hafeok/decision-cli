# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-061>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-073> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-061/0> <https://decision-cli.dev/ns/step/VG-061/1> <https://decision-cli.dev/ns/step/VG-061/2> <https://decision-cli.dev/ns/step/VG-061/3> <https://decision-cli.dev/ns/step/VG-061/4> <https://decision-cli.dev/ns/step/VG-061/5> <https://decision-cli.dev/ns/step/VG-061/6> <https://decision-cli.dev/ns/step/VG-061/7> ) .

<https://decision-cli.dev/ns/step/VG-061/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p test-workspace && cd test-workspace && dec init --no-remote" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec graph create --name test-graph" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec session create --name test-session" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && echo '[]' > test-artifact.json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-123> ;
    dec:command "cd test-workspace && dec artifact create --name test-artifact --content test-artifact.json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/5>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-123> ;
    dec:command "cd test-workspace && dec graph write --graph test-graph --artifact test-artifact --session test-session" ;
    dec:expectExitCode 1 .

<https://decision-cli.dev/ns/step/VG-061/6>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-123> ;
    dec:command "cd test-workspace && dec feedback list" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-061/7>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-123> ;
    dec:target "test-workspace/.dec/store" ;
    dec:query "PREFIX prov: <http://www.w3.org/ns/prov#> PREFIX dec: <https://decisionframework.org/> SELECT ?s ?p ?o WHERE { ?s ?p ?o . FILTER(?p = prov:wasGeneratedBy || ?p = prov:wasAttributedTo || ?p = prov:generatedAtTime) }" .
