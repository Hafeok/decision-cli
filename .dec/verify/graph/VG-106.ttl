# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-106>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-019> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-106/0> <https://decision-cli.dev/ns/step/VG-106/1> <https://decision-cli.dev/ns/step/VG-106/2> ) .

<https://decision-cli.dev/ns/step/VG-106/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-106/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-088> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?role WHERE { ?role a dec:Role ; dec:roleId \"verifier\" . }" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-106/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-027> ;
    dec:target ".dec/store/orchestration.nq" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?a ?i WHERE { ?a a dec:ActionSession . ?a dec:groupedBy ?g . ?g dec:hasInterpretation ?i . ?i a dec:InterpretationSession . }" ;
    dec:expectRows 1 .
