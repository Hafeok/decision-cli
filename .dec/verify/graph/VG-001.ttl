# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-001>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-008> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-001> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-001/0> <https://decision-cli.dev/ns/step/VG-001/1> <https://decision-cli.dev/ns/step/VG-001/2> ) .

<https://decision-cli.dev/ns/step/VG-001/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-001/1>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:path ".dec/store" .

<https://decision-cli.dev/ns/step/VG-001/2>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:path ".dec/config.toml" .
