# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-098>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-030> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-098/0> <https://decision-cli.dev/ns/step/VG-098/1> <https://decision-cli.dev/ns/step/VG-098/2> <https://decision-cli.dev/ns/step/VG-098/3> <https://decision-cli.dev/ns/step/VG-098/4> ) .

<https://decision-cli.dev/ns/step/VG-098/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-098/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec doctor --format json" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-098/2>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:path "core/role_catalog/seeds/implementer-authority.ttl" ;
    dec:expectContent "dec:mayDecide" .

<https://decision-cli.dev/ns/step/VG-098/3>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:path "core/role_catalog/seeds/verifier-authority.ttl" ;
    dec:expectContent "dec:mayDecide" .

<https://decision-cli.dev/ns/step/VG-098/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?role ?authority WHERE { ?role a dec:Role ; dec:authority ?authority . ?authority a dec:Authority . }" ;
    dec:expectRows 2 .
