# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-093>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-009> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-093/0> <https://decision-cli.dev/ns/step/VG-093/1> <https://decision-cli.dev/ns/step/VG-093/2> <https://decision-cli.dev/ns/step/VG-093/3> ) .

<https://decision-cli.dev/ns/step/VG-093/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-001> ;
    dec:command "dec init" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-093/1>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-002> ;
    dec:path ".dec/config.toml" .

<https://decision-cli.dev/ns/step/VG-093/2>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-015> ;
    dec:path ".dec/store" .

<https://decision-cli.dev/ns/step/VG-093/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-019> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?s ?p ?o WHERE { ?s ?p ?o }" ;
    dec:expectRows 2 .
