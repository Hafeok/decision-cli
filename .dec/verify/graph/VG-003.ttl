# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-003>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-007> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-003/0> <https://decision-cli.dev/ns/step/VG-003/1> <https://decision-cli.dev/ns/step/VG-003/2> ) .

<https://decision-cli.dev/ns/step/VG-003/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-003/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?stream WHERE { ?stream a dec:ValueStream } LIMIT 1" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-003/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> SELECT ?action WHERE { ?action a dec:ValueAction FILTER(CONTAINS(STR(?action), \"shipped-feature\")) } LIMIT 1" ;
    dec:expectRows 1 .
