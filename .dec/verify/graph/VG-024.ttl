@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-024>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-038> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-024/0> <https://decision-cli.dev/ns/step/VG-024/1> <https://decision-cli.dev/ns/step/VG-024/2> <https://decision-cli.dev/ns/step/VG-024/3> ) .

<https://decision-cli.dev/ns/step/VG-024/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-060> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-052> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-051> ;
    dec:command "dec verify env new --type ephemeral-tempdir --safety-class isolated --allowed-ops shell,filesystem,sparql-local" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-024/1>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-051> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-052> ;
    dec:path ".dec/verify/env/BNCH-001.ttl" .

<https://decision-cli.dev/ns/step/VG-024/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-060> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns/> SELECT ?s ?p ?o WHERE { ?s ?p ?o . }" .

<https://decision-cli.dev/ns/step/VG-024/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-094> ;
    dec:command "dec verify env new --type ephemeral-tempdir --safety-class isolated --allowed-ops shell,filesystem,sparql-local --id BNCH-002" ;
    dec:expectExitCode 0 .
