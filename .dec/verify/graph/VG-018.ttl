# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-018>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-030> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-018/0> <https://decision-cli.dev/ns/step/VG-018/1> <https://decision-cli.dev/ns/step/VG-018/2> <https://decision-cli.dev/ns/step/VG-018/3> <https://decision-cli.dev/ns/step/VG-018/4> <https://decision-cli.dev/ns/step/VG-018/5> <https://decision-cli.dev/ns/step/VG-018/6> <https://decision-cli.dev/ns/step/VG-018/7> <https://decision-cli.dev/ns/step/VG-018/8> <https://decision-cli.dev/ns/step/VG-018/9> ) .

<https://decision-cli.dev/ns/step/VG-018/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" .

<https://decision-cli.dev/ns/step/VG-018/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "touch .dec/store/role_catalog.ttl" .

<https://decision-cli.dev/ns/step/VG-018/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-ethics.org/ns/dec#> SELECT ?role WHERE { ?role a dec:Role . }" .

<https://decision-cli.dev/ns/step/VG-018/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-ethics.org/ns/dec#> SELECT ?authority WHERE { ?authority a dec:Authority . }" .

<https://decision-cli.dev/ns/step/VG-018/4>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:path "core/role_catalog/seeds/implementer-authority.ttl" .

<https://decision-cli.dev/ns/step/VG-018/5>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:path "core/role_catalog/seeds/verifier-authority.ttl" .

<https://decision-cli.dev/ns/step/VG-018/6>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-ethics.org/ns/dec#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?shape WHERE { ?shape a sh:NodeShape . FILTER(regex(str(?shape), 'RoleShape')) }" .

<https://decision-cli.dev/ns/step/VG-018/7>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-ethics.org/ns/dec#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?shape WHERE { ?shape a sh:NodeShape . FILTER(regex(str(?shape), 'AuthorityShape')) }" .

<https://decision-cli.dev/ns/step/VG-018/8>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:command "cargo run --bin dec -- init --store-path .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-018/9>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-041> ;
    dec:command "cargo run --bin dec -- role-catalog list" ;
    dec:expectExitCode 0 .
