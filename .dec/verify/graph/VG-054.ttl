@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-054>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-013> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-054/0> <https://decision-cli.dev/ns/step/VG-054/1> <https://decision-cli.dev/ns/step/VG-054/2> ) .

<https://decision-cli.dev/ns/step/VG-054/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p /tmp/test-workspace && echo 'test bundle content' > /tmp/test-bundle.md" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-054/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-013> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-011> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:command "cd /tmp/test-workspace && claude -p 'Write a simple hello world Python function to test-file.py' --system-prompt-file /tmp/test-bundle.md --dangerously-skip-permissions --output-format stream-json --verbose" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-054/2>
    a dec:VerificationStep ;
    dec:stepType "file-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-008> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-011> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-013> ;
    dec:path "/tmp/test-workspace/test-file.py" .
