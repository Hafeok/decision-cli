# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-088>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-100> ;
    dec:environment <https://decision-cli.dev/ns/env/ENV-001> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-088/0> <https://decision-cli.dev/ns/step/VG-088/1> <https://decision-cli.dev/ns/step/VG-088/2> <https://decision-cli.dev/ns/step/VG-088/3> <https://decision-cli.dev/ns/step/VG-088/4> <https://decision-cli.dev/ns/step/VG-088/5> ) .

<https://decision-cli.dev/ns/step/VG-088/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store && touch .dec/store/graph_accepted_dispatch_test.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-088/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-162> ;
    dec:command "dec verify graph new --env ENV-001 --file .dec/store/graph_accepted_dispatch_test.ttl" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-088/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-163> ;
    dec:command "dec verify feature --feature FT-100 --env ENV-001" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-088/3>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-164> ;
    dec:command "dec session list" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-088/4>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-162> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decentralized-data.eu/> SELECT ?s WHERE { ?s a dec:VerificationGraph . }" .

<https://decision-cli.dev/ns/step/VG-088/5>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-164> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decentralized-data.eu/> SELECT ?s WHERE { ?s a dec:Session . FILTER(?s != ?other) . }" .
