    dec:command "mkdir -p test-workspace" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-049/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec init --name test-chain" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-049/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec graph create --name escalation-test" ;
