<https://decision-cli.dev/ns/step/VG-049/6>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-109> ;
    dec:command "cd test-workspace && dec dispatch --role test-role --bundle initial-bundle" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-049/7>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-110> ;
    dec:command "cd test-workspace && dec session list" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-049/8>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-111> ;
    dec:command "cd test-workspace && dec session show --session-id $(dec session list | grep -o '[a-zA-Z0-9]\\{32\\}')" ;
