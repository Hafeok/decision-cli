<https://decision-cli.dev/ns/step/VG-049/11>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec sparql --query 'SELECT ?s ?p ?o WHERE { ?s ?p ?o }' --store .dec/store" ;
