<https://decision-cli.dev/ns/step/VG-049/4>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "cd test-workspace && dec escalation-step create --role test-role --trigger stakes_routine --capability escalate-to-higher" ;
