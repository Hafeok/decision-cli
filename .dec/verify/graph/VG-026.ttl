@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-026>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-040> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-026/0> <https://decision-cli.dev/ns/step/VG-026/1> <https://decision-cli.dev/ns/step/VG-026/2> <https://decision-cli.dev/ns/step/VG-026/3> ) .

<https://decision-cli.dev/ns/step/VG-026/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-051> ;
    dec:command "dec verify env show BNCH-001 --format text" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-026/1>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-052> ;
    dec:command "dec verify env show BNCH-001 --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-026/2>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-062> ;
    dec:command "dec_verify_env_show --id BNCH-001 --format json" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-026/3>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-051> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-052> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-062> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns/> SELECT ?env WHERE { ?env a dec:VerificationEnvironment . }" .
