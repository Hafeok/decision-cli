# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-031>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-045> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-031/0> <https://decision-cli.dev/ns/step/VG-031/1> ) .

<https://decision-cli.dev/ns/step/VG-031/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "mkdir -p .dec/store" ;
    dec:expectExitCode 0 .

<https://decision-cli.dev/ns/step/VG-031/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-068> ;
    dec:providesEvidenceFor <https://decision-cli.dev/ns/tc/TC-069> ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns/>\nSELECT ?step WHERE {\n  GRAPH <https://decision-cli.dev/ns/graph/verify-graph> {\n    ?graph dec:steps/rdf:rest*/rdf:first ?step .\n    ?step dec:providesEvidenceFor ?tc .\n  }\n}" .
