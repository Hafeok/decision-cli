# decision-cli VerificationGraph artifact.
# Authored by FT-036 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://decision-cli.dev/ns/graph/VG-002>
    a dec:VerificationGraph ;
    dec:verifies <https://decision-cli.dev/ns/feature/FT-006> ;
    dec:bench <https://decision-cli.dev/ns/bench/BNCH-002> ;
    dec:steps ( <https://decision-cli.dev/ns/step/VG-002/0> <https://decision-cli.dev/ns/step/VG-002/1> <https://decision-cli.dev/ns/step/VG-002/2> ) .

<https://decision-cli.dev/ns/step/VG-002/0>
    a dec:VerificationStep ;
    dec:stepType "shell-command" ;
    dec:command "dec init --template engineering-development" ;
    dec:expectExitCode 0 ;
    dec:captureOutput true .

<https://decision-cli.dev/ns/step/VG-002/1>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?shape WHERE { ?shape a sh:NodeShape } LIMIT 1" ;
    dec:expectRows 1 .

<https://decision-cli.dev/ns/step/VG-002/2>
    a dec:VerificationStep ;
    dec:stepType "sparql-assertion" ;
    dec:target ".dec/store" ;
    dec:query "PREFIX dec: <https://decision-cli.dev/ns#> PREFIX prov: <http://www.w3.org/ns/prov#> SELECT ?session ?ontologyHash WHERE { ?session a dec:Session ; dec:ontologyHash ?ontologyHash } LIMIT 1" ;
    dec:expectRows 1 .
