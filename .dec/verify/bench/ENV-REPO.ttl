# decision-cli VerificationEnvironment artifact.
# Authored by FT-035 / ADR-028. On-disk Turtle is authoritative.

@prefix dec: <https://decision-cli.dev/ns#> .

<https://decision-cli.dev/ns/bench/BNCH-REPO>
    a dec:VerificationEnvironment ;
    dec:envType "repo-path" ;
    dec:safetyClass "shared-non-destructive" ;
    dec:allowedOps ( "shell" "filesystem" "sparql-local" ) ;
    dec:fixtureSource "." ;
    dec:concreteCapabilities [
        dec:binariesOnPath ( "bash" "dec" "product" "cargo" "rustc" "python" "python3" "uv" "grep" "find" "ls" "cat" "mkdir" "touch" "echo" "sed" "awk" "head" "tail" "wc" "test" "cd" "rm" "cp" "mv" "diff" "jq" "curl" "git" "true" "false" ) ;
        dec:writablePaths ( "./" "target/" ".dec/" ) ;
        dec:benchVariables ( "DEC_VERIFY_TMP" "DEC_WORKDIR" "TMPDIR" "PATH" "HOME" "CARGO_HOME" "RUSTUP_HOME" ) ;
        dec:preSeededArtifacts ( "Cargo.toml" "Cargo.lock" "crates/" "workers/" "scripts/" ".product/" ".dec/" )
    ] .
