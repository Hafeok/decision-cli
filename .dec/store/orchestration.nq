<https://decision-cli.dev/ns/step/VG-053/3> <https://decision-cli.dev/ns#command> "cd /tmp/test-workspace && SCW_SECRET_KEY=test-key python3 -c \"import os; import json; payload = json.load(open('payload2.json')); env = os.environ.copy(); env['SCW_SECRET_KEY'] = 'test-key'; env['ANTHROPIC_BASE_URL'] = 'http://localhost:8787'; env['ANTHROPIC_AUTH_TOKEN'] = 'test-key'; env['ANTHROPIC_MODEL'] = payload['model_id']; env['ANTHROPIC_DEFAULT_HAIKU_MODEL'] = payload['model_id']; env['ANTHROPIC_SMALL_FAST_MODEL'] = payload['model_id']; env['ANTHROPIC_DEFAULT_SONET_MODEL'] = payload['model_id']; env['ANTHROPIC_DEFAULT_OPUS_MODEL'] = payload['model_id']; print(json.dumps(env))\" > scaleway_env_output.json" <https://decision-cli.dev/ns/graph/verify-graph> .
