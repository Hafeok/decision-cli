<https://decision-cli.dev/ns/step/VG-072/0> <https://decision-cli.dev/ns#command> "mkdir -p /tmp/test-event-driver && cd /tmp/test-event-driver && python -c \"import asyncio; import aiohttp; from aiohttp import web; import json; import time; async def sse_handler(request): headers = {'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache'}; response = web.StreamResponse(headers=headers); await response.prepare(request); for i in range(3): await response.write(f'data: {json.dumps({\\\"id\\\": i, \\\"event\\\": \\\"dispatch\\\", \\\"data\\\": {\\\"session_id\\\": f\\\"session-{i}\\\", \\\"claim_id\\\": f\\\"claim-{i}\\\"}})}\\n\\n'.encode()); await asyncio.sleep(0.1); return response; app = web.Application(); app.router.add_get('/sse', sse_handler); web.run_app(app, host='localhost', port=8080)\"" <https://decision-cli.dev/ns/graph/verify-graph> .
