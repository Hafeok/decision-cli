<https://decision-cli.dev/ns/step/VG-022/2> <https://decision-cli.dev/ns#command> "echo \"import json\\n\\n# Mock worker emitting feedback\\nemission = {\\n    \\\"feedback_class\\\": \\\"gap\\\",\\n    \\\"severity\\\": \\\"high\\\",\\n    \\\"evidence\\\": \\\"Test evidence string with more than twenty characters\\\",\\n    \\\"recommendation\\\": \\\"Recommendation here\\\",\\n    \\\"target_role_override\\\": \\\"test-role\\\",\\n    \\\"blocking\\\": True,\\n    \\\"disposition_rationale\\\": \\\"Rationale for blocking\\\"\\n}\\n\\nprint('__DEC_FEEDBACK__' + json.dumps(emission))\" > ./test-worker/mock_worker.py" <https://decision-cli.dev/ns/graph/verify-graph> .
