{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "title": "MCP server.json (committed copy for TC-181 offline validation)",
  "description": "Minimal-but-faithful copy of the registry's server.schema.json. The full schema is fetched from the registry on a nightly job (TC-181 §Scenario C); on PR runs, this committed copy is used. Update by re-downloading the upstream schema and replacing this file.",
  "type": "object",
  "required": ["$schema", "name", "description", "version", "packages"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^/]+/[^/]+$"
    },
    "description": {
      "type": "string",
      "minLength": 16,
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "websiteUrl": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "object",
      "required": ["url", "source"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source": {"type": "string", "minLength": 1},
        "id": {"type": "string"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["registryType", "identifier", "version", "transport", "fileSha256", "runtimeArguments"],
        "properties": {
          "registryType": {"type": "string", "minLength": 1},
          "identifier": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "transport": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"type": "string"}
            }
          },
          "fileSha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "runtimeArguments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
