# Product CLI — generated files
.product/graph/
.product/sessions/
.product/checklist.md
.product.lock

# Rust
/target/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Editor / OS
.DS_Store

# WSL/NTFS metadata streams
*:Zone.Identifier

# Claude Code state (subagent worktrees, local settings)
.claude/

# Local run logs (implement-all.sh, etc.)
.logs/

# Test-fixture tempdirs that escape /tmp (e.g. TMPDIR=. accidents).
# The tempdir() helpers in crates/decision-cli/tests/ label fixtures with
# the FT/TC id; pin the labels at root so a polluted tree gets caught
# before commit instead of after.
/decision-cli-ft*-*/
/env-comments-*/
/env-good-*/
/env-malformed-*/
/env-missing-*/
/ft-???-*-*/
