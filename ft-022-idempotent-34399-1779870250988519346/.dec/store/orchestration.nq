<https://decision-cli.dev/ns/subscription/feedback-resume> <http://www.w3.org/2000/01/rdf-schema#label> "feedback resume check (terminal feedback unblocks paused dispatch)" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-resume> <https://decision-cli.dev/oxi-events/ns#handler> "feedback-resume" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-resume> <https://decision-cli.dev/oxi-events/ns#mode> "inline" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-resume> <https://decision-cli.dev/oxi-events/ns#selectQuery> "PREFIX dec: <https://decision-cli.dev/ns#>\nSELECT DISTINCT ?group WHERE {\n  { ?group a dec:DispatchGroup ;\n           dec:dispatchStatus \"paused-for-feedback\" ;\n           dec:blockedBy ?feedback .\n    ?feedback dec:lifecycleState ?state .\n    FILTER(?state IN (\"addressed\", \"rejected\", \"closed\")) }\n  UNION\n  { GRAPH ?g {\n      ?group a dec:DispatchGroup ;\n             dec:dispatchStatus \"paused-for-feedback\" ;\n             dec:blockedBy ?feedback .\n      ?feedback dec:lifecycleState ?state .\n      FILTER(?state IN (\"addressed\", \"rejected\", \"closed\"))\n    } }\n}" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-resume> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://decision-cli.dev/oxi-events/ns#Subscription> <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-routing> <http://www.w3.org/2000/01/rdf-schema#label> "feedback routing (produced → routed)" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-routing> <https://decision-cli.dev/oxi-events/ns#handler> "feedback-routing" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-routing> <https://decision-cli.dev/oxi-events/ns#mode> "inline" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-routing> <https://decision-cli.dev/oxi-events/ns#selectQuery> "PREFIX dec: <https://decision-cli.dev/ns#>\nSELECT ?feedback ?class ?targetOverride ?sourceSession WHERE {\n  { ?feedback a dec:Feedback ;\n              dec:lifecycleState \"produced\" ;\n              dec:feedbackClass ?class ;\n              dec:sourceSession ?sourceSession .\n    OPTIONAL { ?feedback dec:routingOverride ?targetOverride } }\n  UNION\n  { GRAPH ?g {\n      ?feedback a dec:Feedback ;\n                dec:lifecycleState \"produced\" ;\n                dec:feedbackClass ?class ;\n                dec:sourceSession ?sourceSession .\n      OPTIONAL { ?feedback dec:routingOverride ?targetOverride }\n    } }\n}" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/feedback-routing> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://decision-cli.dev/oxi-events/ns#Subscription> <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/verifier-dispatch> <http://www.w3.org/2000/01/rdf-schema#label> "verifier dispatch (action complete, no verifier yet)" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/verifier-dispatch> <https://decision-cli.dev/oxi-events/ns#handler> "verifier-dispatch" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/verifier-dispatch> <https://decision-cli.dev/oxi-events/ns#mode> "async" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/verifier-dispatch> <https://decision-cli.dev/oxi-events/ns#selectQuery> "PREFIX dec: <https://decision-cli.dev/ns#>\nSELECT ?group ?actionSession WHERE {\n  { ?group a dec:DispatchGroup ;\n           dec:dispatchStatus \"awaiting-interpretation\" ;\n           dec:hasActionSession ?actionSession .\n    FILTER NOT EXISTS { ?group dec:hasInterpretationSession ?interpretationSession } }\n  UNION\n  { GRAPH ?g {\n      ?group a dec:DispatchGroup ;\n             dec:dispatchStatus \"awaiting-interpretation\" ;\n             dec:hasActionSession ?actionSession .\n      FILTER NOT EXISTS { ?group dec:hasInterpretationSession ?interpretationSession }\n    } }\n}" <https://decision-cli.dev/oxi-events/ns/subscriptions> .
<https://decision-cli.dev/ns/subscription/verifier-dispatch> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://decision-cli.dev/oxi-events/ns#Subscription> <https://decision-cli.dev/oxi-events/ns/subscriptions> .
